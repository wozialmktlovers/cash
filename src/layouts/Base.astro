---
import '@/styles/global.css';
import Icono from '@/components/Icono.astro';
import TemaSwitch from '@/components/TemaSwitch.astro';
import Paleta from '@/components/Paleta';
import Campana from '@/components/Campana';
import { SCRIPT_TEMA, COLOR_BARRA } from '@/lib/ui/tema';
import { navegacionCompleta, itemsMenuMas } from '@/lib/ui/navegacion';
import { contarPendientes } from '@/lib/pendientes';
import { nombreVisible } from '@/lib/usuarios';

type Seccion = 'inicio' | 'clientes' | 'entregables' | 'pendientes' | 'usuarios' | 'desempeno';

interface Props {
  titulo: string;
  activo?: Seccion;
  volver?: { href: string; texto: string };
}

const { titulo, activo, volver } = Astro.props;
const usuario = Astro.locals.usuario;

const ETIQUETA_ROL: Record<typeof usuario.rol, string> = { admin: 'Admin', operador: 'Operador', cliente: 'Cliente' };

// «Pendientes» (admin y operador, con contador barato) llega en cada página
// que usa este layout, así que `contarPendientes` es un solo `count`, nunca
// una lista. El cliente nunca la ve (la ruta ya redirige a /portal), así que
// no vale la pena consultar nada para él.
const pendientes = usuario.rol === 'cliente' ? 0 : await contarPendientes(usuario);

// La navegación lateral gana «Pendientes» (admin y operador), «Usuarios»
// (solo admin) y «Desempeño» (admin y operador). El armado por rol vive en
// `navegacionCompleta` (lib/ui/navegacion.ts), probado aparte por rol sin
// tener que renderizar el layout completo.
const NAV = navegacionCompleta(usuario.rol, pendientes);

// Bajo 900px la barra inferior solo tenía Inicio, Clientes, Nuevo y
// Entregables: Pendientes, Desempeño y Usuarios (los tres que `NAV` agrega
// arriba, ya filtrados por rol con la misma regla que `rutaPermitida`) no
// tenían ningún acceso en el celular. Van al menú «Más», junto con «Salir»
// (que en escritorio vive en la cabecera, fuera de la barra de pestañas).
const masItems = itemsMenuMas(NAV);
const masActivo = masItems.some((n) => n.clave === activo);
---

<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{titulo} · Wozial Studio</title>
    <meta name="theme-color" content={COLOR_BARRA.claro} />
    <script is:inline set:html={SCRIPT_TEMA}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#d4688a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <div class="app">
      <aside class="lateral">
        <a href="/" class="marca" aria-label="Wozial Studio · inicio">
          <img class="logo" src="/logo-wozial.png" alt="Wozial" width="545" height="194" />
          <span>Studio</span>
        </a>
        <nav aria-label="Principal">
          <ul>
            {NAV.map((n) => (
              <li>
                <a href={n.href} class:list={['nav-item', { activo: activo === n.clave }]} aria-current={activo === n.clave ? 'page' : undefined}>
                  <Icono nombre={n.icono} />{n.texto}
                  {Boolean(n.contador) && <span class="contador">{n.contador}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a href="/clientes/nuevo" class="btn"><Icono nombre="mas" />Nuevo cliente</a>
      </aside>

      <div class="principal-col">
        <header class="superior">
          <a href="/" class="marca" aria-label="Wozial Studio · inicio">
            <img class="logo" src="/logo-wozial.png" alt="Wozial" width="545" height="194" />
          </a>
          <button type="button" class="buscador-disparador" data-abrir-paleta aria-label="Buscar cliente">
            <Icono nombre="buscar" /><span>Busca un cliente…</span><kbd>⌘K</kbd>
          </button>
          <TemaSwitch />
          <Campana client:load />
          <div class="usuario-sesion">
            <!-- La etiqueta empieza con el mismo texto que se ve, para que
                 quien maneja el navegador por voz pueda decir el nombre. -->
            <a href="/perfil" class="usuario-nombre" aria-label={`${nombreVisible(usuario)} · Mi perfil`}>{nombreVisible(usuario)}</a>
            <span class="usuario-rol">{ETIQUETA_ROL[usuario.rol]}</span>
          </div>
          <form method="POST" action="/api/logout">
            <button type="submit" class="btn fantasma chico">Salir</button>
          </form>
        </header>

        <main id="contenido" class="contenido">
          {volver && <a class="volver" href={volver.href}><Icono nombre="atras" />{volver.texto}</a>}
          <slot />
        </main>
      </div>
    </div>

    <nav class="barra-pestanas" aria-label="Principal">
      <a href="/" class:list={[{ activo: activo === 'inicio' }]} aria-current={activo === 'inicio' ? 'page' : undefined}><Icono nombre="inicio" />Inicio</a>
      <a href="/clientes" class:list={[{ activo: activo === 'clientes' }]} aria-current={activo === 'clientes' ? 'page' : undefined}><Icono nombre="clientes" />Clientes</a>
      <a href="/clientes/nuevo" class="nuevo" aria-label="Nuevo cliente"><Icono nombre="mas" /></a>
      <a href="/entregables" class:list={[{ activo: activo === 'entregables' }]} aria-current={activo === 'entregables' ? 'page' : undefined}><Icono nombre="entregables" />Entregables</a>
      <button
        type="button"
        id="mas-disparador"
        class:list={['mas-boton', { activo: masActivo }]}
        aria-haspopup="dialog"
        aria-controls="mas-menu"
        aria-expanded="false"
      >
        <Icono nombre="puntos" />Más
      </button>
    </nav>

    <dialog id="mas-menu" class="mas-menu" aria-labelledby="mas-menu-titulo">
      <h2 id="mas-menu-titulo" class="sr-solo">Más</h2>
      <ul>
        {masItems.map((n) => (
          <li>
            <a href={n.href} class:list={['nav-item', { activo: activo === n.clave }]} aria-current={activo === n.clave ? 'page' : undefined}>
              <Icono nombre={n.icono} />{n.texto}
              {Boolean(n.contador) && <span class="contador">{n.contador}</span>}
            </a>
          </li>
        ))}
        <li>
          <!-- En celular la cabecera esconde `.usuario-sesion`, así que este es
               el único camino a /perfil para admin y operador. -->
          <a href="/perfil" class="nav-item"><Icono nombre="usuarios" />Mi perfil</a>
        </li>
        <li>
          <form method="POST" action="/api/logout">
            <button type="submit" class="nav-item">Salir</button>
          </form>
        </li>
      </ul>
    </dialog>

    <Paleta client:load />
    <div class="toasts" id="toasts"></div>
  </body>
</html>

<style>
  /* El nombre de la cabecera ahora lleva a /perfil. Se ve igual que antes
     (hereda color de `.usuario-nombre`): solo se subraya al apuntarlo o al
     llegar con el teclado, para que se note que es un enlace sin meter un
     azul que no es del Studio. */
  a.usuario-nombre { text-decoration: none; }
  a.usuario-nombre:hover, a.usuario-nombre:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  // Menú «Más» del celular: un <dialog> nativo da foco atrapado y cierre con
  // Escape sin escribirlo a mano. Solo hace falta abrir/cerrar y devolver el
  // foco al botón que lo abrió (el navegador no lo hace solo).
  const disparadorMas = document.getElementById('mas-disparador');
  const menuMas = document.getElementById('mas-menu');
  if (disparadorMas && menuMas instanceof HTMLDialogElement) {
    disparadorMas.addEventListener('click', () => {
      menuMas.showModal();
      disparadorMas.setAttribute('aria-expanded', 'true');
    });
    menuMas.addEventListener('click', (e) => {
      // Clic en el respaldo (fuera de la tarjeta del diálogo) cierra, igual
      // que Escape: el <dialog> no lo hace solo.
      if (e.target === menuMas) menuMas.close();
    });
    menuMas.addEventListener('close', () => {
      disparadorMas.setAttribute('aria-expanded', 'false');
      disparadorMas.focus();
    });
  }
</script>
