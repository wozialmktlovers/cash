---
import '@/styles/global.css';

interface Props {
  titulo: string;
  migas?: string;
}

const { titulo, migas } = Astro.props;
---

<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{titulo} · Wozial Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#d4688a" />
    <meta name="theme-color" content="#08080b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="sitio">
      <header class="barra">
        <a href="/" class="marca" aria-label="Wozial Studio · inicio">
          <img src="/logo-wozial.png" alt="Wozial" width="545" height="194" />
          <span>Studio</span>
        </a>
        {migas && (
          <nav class="migas" aria-label="Dónde estás">
            {migas.split('›').map((paso, i) => (
              <>
                {i > 0 && <span class="migas-sep" aria-hidden="true">/</span>}
                <span class={i === migas.split('›').length - 1 ? 'migas-actual' : ''}>
                  {paso.trim()}
                </span>
              </>
            ))}
          </nav>
        )}
        <form method="POST" action="/api/logout">
          <button type="submit" class="btn fantasma chico">Salir</button>
        </form>
        <!-- Tira de calibración. En un estudio es lo que se usa para comprobar
             que lo que sale es fiel al original, y verificar es exactamente lo
             que hace este producto. Cada segmento es uno de los cuatro colores
             con los que se clasifica el contenido. -->
        <div class="calibre" aria-hidden="true">
          <i style="--c:var(--pink)"></i>
          <i style="--c:var(--blue)"></i>
          <i style="--c:var(--yellow)"></i>
          <i style="--c:var(--green)"></i>
        </div>
      </header>
      <main class="contenido">
        <slot />
      </main>
    </div>
  </body>
</html>
