---
import { resolverDocumentoPublico } from '@/lib/documento-publico';

const { token } = Astro.params;

// Forma antigua, sin el nombre del negocio. Se conserva porque puede haber
// links ya repartidos: en vez de romperlos, llevan a la forma con nombre.
const r = await resolverDocumentoPublico(token!);
if (r.tipo === 'no-encontrado') return new Response('No encontrado', { status: 404 });

return Astro.redirect(`/p/${r.slug}/${token}`, 301);
---
