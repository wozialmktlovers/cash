---
import '@/styles/global.css';
import Icono from '@/components/Icono.astro';
import TemaSwitch from '@/components/TemaSwitch.astro';
import { SCRIPT_TEMA, COLOR_BARRA } from '@/lib/ui/tema';
import { db, invitaciones, users, clients } from '@/db';
import { eq } from 'drizzle-orm';
import { hashToken, estadoInvitacion, invitacionVigente, type InvitacionEstado } from '@/lib/invitaciones';

const { token } = Astro.params;

const [inv] = token
  ? await db.select().from(invitaciones).where(eq(invitaciones.tokenHash, hashToken(token))).limit(1)
  : [];

const ahora = new Date();
// Las fechas se comprueban primero (barato, sin consultas extra); solo si la
// invitación sigue viva por fecha vale la pena ir a ver si quien la creó
// todavía tiene autoridad para haberla emitido.
let estado: InvitacionEstado = estadoInvitacion(inv ?? null, ahora);
if (estado === 'valida') {
  const [creador] = inv!.creadoPor
    ? await db.select().from(users).where(eq(users.id, inv!.creadoPor)).limit(1)
    : [];
  const [cliente] = inv!.rol === 'cliente' && inv!.clientId
    ? await db.select({ id: clients.id, operadorId: clients.operadorId }).from(clients).where(eq(clients.id, inv!.clientId)).limit(1)
    : [];
  estado = invitacionVigente(inv!, creador ?? null, cliente ?? null, ahora);
}

const errorParam = Astro.url.searchParams.get('error');
const MENSAJES_ERROR: Record<string, string> = {
  datos: 'Revisa los datos: nombre, una contraseña de al menos 12 caracteres y que la confirmación coincida.',
  'ya-existe': 'Ya existe una cuenta con ese correo. Si es tuya, entra desde la página de acceso.',
  usada: 'Esta invitación ya se usó.',
  vencida: 'Esta invitación venció.',
  inexistente: 'Esta invitación no existe o fue revocada.',
  revocada: 'Esta invitación ya no es válida. Pide una nueva a tu equipo.',
};
const avisoError = errorParam ? (MENSAJES_ERROR[errorParam] ?? 'No se pudo completar la invitación.') : null;

const MENSAJES_ESTADO: Record<'vencida' | 'usada' | 'inexistente' | 'revocada', string> = {
  vencida: 'Esta invitación venció. Pide que te manden una nueva.',
  usada: 'Esta invitación ya se usó. Si ya tienes cuenta, entra desde la página de acceso.',
  // Revocar borra la invitación (M2 punto 4), así que un enlace revocado llega aquí.
  inexistente: 'Esta invitación no existe o fue revocada. Revisa el enlace o pide que te manden uno nuevo.',
  revocada: 'Esta invitación ya no es válida. Pide una nueva a tu equipo.',
};
---

<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Crear acceso · Wozial Studio</title>
    <meta name="theme-color" content={COLOR_BARRA.claro} />
    <script is:inline set:html={SCRIPT_TEMA}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="login-switch"><TemaSwitch /></div>
    <main class="login">
      {estado === 'valida' ? (
        <form method="POST" action="/api/invitacion/aceptar">
          <img class="logo" src="/logo-wozial.png" alt="Wozial" width="545" height="194" />
          <p class="eyebrow">Studio · Crear acceso</p>
          <h1 class="display">Termina de crear tu cuenta</h1>

          <input type="hidden" name="token" value={token} />

          <div class="campo">
            <label for="nombre">Nombre</label>
            <input id="nombre" name="nombre" type="text" autocomplete="name" required autofocus />
          </div>

          <div class="campo">
            <label for="password">Contraseña</label>
            <div class="con-icono">
              <Icono nombre="candado" />
              <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required />
            </div>
            <p class="ayuda">Mínimo 12 caracteres.</p>
          </div>

          <div class="campo">
            <label for="confirmacion">Confirma la contraseña</label>
            <div class="con-icono">
              <Icono nombre="candado" />
              <input id="confirmacion" name="confirmacion" type="password" autocomplete="new-password" minlength="12" required />
            </div>
          </div>

          {avisoError && <p class="aviso rosa" role="alert">{avisoError}</p>}

          <button type="submit" class="btn ancho-total">Crear mi acceso</button>
        </form>
      ) : (
        <div class="invitacion-cerrada">
          <img class="logo" src="/logo-wozial.png" alt="Wozial" width="545" height="194" />
          <p class="eyebrow">Studio · Invitación</p>
          <h1 class="display">{MENSAJES_ESTADO[estado as 'vencida' | 'usada' | 'inexistente' | 'revocada']}</h1>
          <a class="btn ancho-total" href="/login">Ir a la página de acceso</a>
        </div>
      )}
    </main>
  </body>
</html>

<style>
  .login-switch { position: fixed; top: 16px; right: 16px; }
  .login { min-height: 100dvh; display: grid; place-items: center; padding: 72px 16px 40px; }
  form, .invitacion-cerrada { width: min(400px, 100%); display: flex; flex-direction: column; gap: 18px; }
  /* El form (y el bloque de invitación cerrada) son flex-column con
     align-items:stretch por defecto, así que sin align-self el <img> se
     estira al ancho del contenedor y pierde su proporción. */
  .logo { height: 48px; margin-bottom: 18px; align-self: center; }
  .display { margin-bottom: 10px; font: var(--t-h1); letter-spacing: var(--tracking-titulo); }
  .invitacion-cerrada { text-align: center; align-items: center; }
</style>
