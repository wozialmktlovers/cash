---
import { and, asc, eq, gt, inArray, isNull, ne, sql } from 'drizzle-orm';
import Base from '@/layouts/Base.astro';
import Icono from '@/components/Icono.astro';
import { db, users, clients, invitaciones, etapaResponsables } from '@/db';
import { PUESTOS, NOMBRE_PUESTO } from '@/flujo/reglas';
import { fechaCorta } from '@/lib/ui/fecha';
import { nombreVisible, ordenUsuarios } from '@/lib/usuarios';

const usuario = Astro.locals.usuario;

// Equipo: admin y operador.
// El orden lo pone `ordenUsuarios` en memoria y no un `ORDER BY`: la regla es
// apellido, luego nombre, con `localeCompare` en español y quien todavía no
// tenga ninguno de los dos al final por correo. Postgres no la reproduce sin
// una colación aparte, y la consulta ya trae la lista entera.
const equipo = (
  await db
    .select({ id: users.id, nombre: users.nombre, apellido: users.apellido, email: users.email, rol: users.rol, puesto: users.puesto, activo: users.activo })
    .from(users)
    .where(ne(users.rol, 'cliente'))
).sort(ordenUsuarios);

// Cuántas etapas (de cualquier cliente) lleva cada quien como responsable.
const conteoEtapas = await db
  .select({ usuarioId: etapaResponsables.usuarioId, n: sql<number>`count(*)::int` })
  .from(etapaResponsables)
  .groupBy(etapaResponsables.usuarioId);
const etapasPorUsuario = new Map(conteoEtapas.map((c) => [c.usuarioId, c.n]));

// Usuarios de clientes.
const usuariosCliente = (
  await db
    .select({ id: users.id, nombre: users.nombre, apellido: users.apellido, email: users.email, activo: users.activo, clientId: users.clientId })
    .from(users)
    .where(eq(users.rol, 'cliente'))
).sort(ordenUsuarios);

const clienteIds = [...new Set(usuariosCliente.map((u) => u.clientId).filter((x): x is string => !!x))];
const nombresCliente = clienteIds.length ? await db.select({ id: clients.id, nombre: clients.nombre }).from(clients).where(inArray(clients.id, clienteIds)) : [];
const nombrePorCliente = new Map(nombresCliente.map((c) => [c.id, c.nombre]));

// Todos los clientes, para el select de «Invitar» cuando el rol es cliente.
const clientesTodos = await db.select({ id: clients.id, nombre: clients.nombre }).from(clients).orderBy(asc(clients.nombre));

// «Operador» es el nivel de permiso interno; de cara al usuario se muestra el
// puesto (Strategist, Content Creator…), nunca la palabra a secas.
const ETIQUETA_ROL: Record<'admin' | 'operador', string> = { admin: 'Admin', operador: 'Con puesto' };
const etiquetaEquipo = (rol: string, puesto: keyof typeof NOMBRE_PUESTO | null) =>
  rol === 'admin' ? 'Admin' : puesto ? NOMBRE_PUESTO[puesto] : 'Sin puesto';

// Invitaciones de equipo pendientes (M2 punto 4): sin usar, sin vencer y sin
// cliente (las de usuarios de cliente se revocan desde la ficha de cada uno).
const invitacionesEquipo = await db
  .select({ id: invitaciones.id, email: invitaciones.email, rol: invitaciones.rol, puesto: invitaciones.puesto, expiraEn: invitaciones.expiraEn })
  .from(invitaciones)
  .where(and(isNull(invitaciones.clientId), ne(invitaciones.rol, 'cliente'), isNull(invitaciones.usadaEn), gt(invitaciones.expiraEn, new Date())))
  .orderBy(asc(invitaciones.expiraEn));
---

<Base titulo="Usuarios" activo="usuarios">
  <div class="encabezado">
    <div>
      <h1>Usuarios</h1>
      <p class="sub">{equipo.length} en el equipo · {usuariosCliente.length} de clientes</p>
    </div>
    <button type="button" class="btn" id="abrir-invitar"><Icono nombre="mas" />Invitar</button>
  </div>

  <section class="tarjeta">
    <h2>Equipo</h2>
    <p class="sub" style="margin-bottom:18px">Admin y equipo con puesto. El puesto y el acceso se cambian aquí.</p>
    {equipo.length === 0 ? (
      <div class="vacio">
        <Icono nombre="usuarios" />
        <strong>Sin usuarios internos todavía</strong>
        Invita al primer admin o a alguien del equipo.
      </div>
    ) : (
      <ul class="lista" id="lista-equipo">
        {equipo.map((u) => {
          const nEtapas = etapasPorUsuario.get(u.id) ?? 0;
          const esUnoMismo = u.id === usuario.id;
          return (
            <li class="renglon renglon-usuario" data-usuario-id={u.id} data-nombre={u.nombre ?? ''} data-apellido={u.apellido ?? ''} data-email={u.email}>
              <div class="cuerpo">
                <strong>{nombreVisible(u)}</strong>
                {/* El correo va en su propio <span> para que el script lo
                    reemplace sin pisar el resto de la línea. */}
                <p class="secundario"><span data-correo>{u.email}</span></p>
                <p class="secundario">
                  <span data-puesto-texto>{etiquetaEquipo(u.rol, u.puesto)}</span>{u.rol === 'operador' && ` · ${nEtapas === 0 ? 'Sin etapas asignadas' : `${nEtapas} ${nEtapas === 1 ? 'etapa asignada' : 'etapas asignadas'}`}`}
                </p>
                {!u.activo && nEtapas > 0 && (
                  <p class="secundario aviso-inline"><Icono nombre="alerta" />Inactivo con etapas asignadas: reasígnalas desde la ficha de cada cliente.</p>
                )}
              </div>
              <select class="rol-select" data-id={u.id} disabled={esUnoMismo} aria-label={`Rol de ${nombreVisible(u)}`}>
                {(Object.keys(ETIQUETA_ROL) as Array<'admin' | 'operador'>).map((r) => (
                  <option value={r} selected={u.rol === r}>{ETIQUETA_ROL[r]}</option>
                ))}
              </select>
              <select class="puesto-select" data-id={u.id} hidden={u.rol !== 'operador'} aria-label={`Puesto de ${nombreVisible(u)}`}>
                <option value="" disabled selected={!u.puesto}>Elige puesto…</option>
                {PUESTOS.map((p) => <option value={p} selected={u.puesto === p}>{NOMBRE_PUESTO[p]}</option>)}
              </select>
              <button type="button" class="btn fantasma chico" data-editar={u.id} aria-label={`Editar a ${nombreVisible(u)}`}>Editar</button>
              <label class="switch" title={esUnoMismo ? 'No puedes desactivarte a ti mismo' : u.activo ? 'Activo' : 'Inactivo'}>
                <input type="checkbox" class="activo-switch" data-id={u.id} checked={u.activo} disabled={esUnoMismo} aria-label={`Activo: ${nombreVisible(u)}`} />
                <span class="riel"><span class="perilla"></span></span>
              </label>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  {invitacionesEquipo.length > 0 && (
    <section class="tarjeta">
      <h2>Invitaciones de equipo pendientes</h2>
      <p class="sub" style="margin-bottom:18px">Aún no se aceptan. Revocar deja el enlace sin efecto.</p>
      <ul class="lista" id="invitaciones-equipo">
        {invitacionesEquipo.map((inv) => (
          <li class="renglon" data-invitacion-id={inv.id}>
            <div class="cuerpo">
              <strong>{inv.email}</strong>
              <p class="secundario">{inv.rol === 'admin' ? 'Admin' : inv.puesto ? NOMBRE_PUESTO[inv.puesto] : 'Sin puesto (vuelve a invitar)'} · vence {fechaCorta(inv.expiraEn)}</p>
            </div>
            <button type="button" class="btn fantasma chico" data-revocar-invitacion={inv.id} aria-label={`Revocar la invitación de ${inv.email}`}>Revocar</button>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="tarjeta">
    <h2>Usuarios de clientes</h2>
    <p class="sub" style="margin-bottom:18px">Acceden solo al portal de su cliente.</p>
    {usuariosCliente.length === 0 ? (
      <div class="vacio">
        <Icono nombre="usuarios" />
        <strong>Sin usuarios de clientes todavía</strong>
        Se invitan desde la ficha de cada cliente, o aquí mismo.
      </div>
    ) : (
      <ul class="lista">
        {usuariosCliente.map((u) => (
          <li class="renglon" data-usuario-id={u.id} data-nombre={u.nombre ?? ''} data-apellido={u.apellido ?? ''} data-email={u.email}>
            <div class="cuerpo">
              <strong>{nombreVisible(u)}</strong>
              {/* Aquí la línea secundaria lleva además el nombre del cliente, así
                  que el correo va en su propio <span>: el script cambia solo eso. */}
              <p class="secundario"><span data-correo>{u.email}</span> · {u.clientId ? (nombrePorCliente.get(u.clientId) ?? 'Cliente') : 'Sin cliente'}</p>
            </div>
            <button type="button" class="btn fantasma chico" data-editar={u.id} aria-label={`Editar a ${nombreVisible(u)}`}>Editar</button>
            {/* Mismo control que el equipo (la API ya permite desactivar/reactivar
                un usuario de cliente): antes era una etiqueta de solo lectura. */}
            <label class="switch" title={u.activo ? 'Activo' : 'Inactivo'}>
              <input type="checkbox" class="activo-switch" data-id={u.id} checked={u.activo} aria-label={`Activo: ${nombreVisible(u)}`} />
              <span class="riel"><span class="perilla"></span></span>
            </label>
          </li>
        ))}
      </ul>
    )}
  </section>

  <dialog id="dialogo-invitar" aria-labelledby="invitar-titulo">
    <h2 id="invitar-titulo">Invitar</h2>
    <form id="forma-invitar">
      <div class="campos" style="margin-top:16px">
        <div class="campo ancho">
          <label for="inv-email">Correo</label>
          <input id="inv-email" name="email" type="email" autocomplete="off" required />
        </div>
        <div class="campo">
          <label for="inv-rol">Rol</label>
          <select id="inv-rol" name="rol" required>
            <option value="admin">Admin</option>
            <option value="operador">Equipo con puesto</option>
            <option value="cliente">Usuario de cliente</option>
          </select>
        </div>
        <div class="campo" id="inv-puesto-campo" hidden>
          <label for="inv-puesto">Puesto</label>
          <select id="inv-puesto" name="puesto">
            <option value="">Selecciona…</option>
            {PUESTOS.map((p) => <option value={p}>{NOMBRE_PUESTO[p]}</option>)}
          </select>
        </div>
        <div class="campo" id="inv-cliente-campo" hidden>
          <label for="inv-cliente">Cliente</label>
          <select id="inv-cliente" name="clientId">
            <option value="">Selecciona…</option>
            {clientesTodos.map((c) => <option value={c.id}>{c.nombre}</option>)}
          </select>
        </div>
      </div>

      <div id="inv-resultado" hidden style="margin-top:16px">
        <p class="aviso verde" id="inv-mensaje"></p>
        <div class="campo con-icono" style="margin-top:10px">
          <Icono nombre="enlace" />
          <input id="inv-enlace" type="text" readonly aria-label="Enlace de invitación" />
        </div>
        <button type="button" class="btn fantasma chico" id="inv-copiar" style="margin-top:10px"><Icono nombre="copiar" />Copiar</button>
      </div>

      <p class="aviso rosa" id="inv-error" hidden role="alert"></p>

      <div class="acciones">
        <button type="submit" class="btn" id="inv-enviar">Invitar</button>
        <button type="button" class="btn fantasma" id="inv-cerrar">Cerrar</button>
      </div>
    </form>
  </dialog>

  <dialog id="dialogo-editar" aria-labelledby="editar-titulo">
    <h2 id="editar-titulo">Editar usuario</h2>
    <form id="forma-editar">
      <div class="campos" style="margin-top:16px">
        <div class="campo">
          <label for="ed-nombre">Nombre</label>
          <input id="ed-nombre" name="nombre" type="text" maxlength="60" autocomplete="off" />
        </div>
        <div class="campo">
          <label for="ed-apellido">Apellido</label>
          <input id="ed-apellido" name="apellido" type="text" maxlength="60" autocomplete="off" />
        </div>
        <div class="campo ancho">
          <label for="ed-email">Correo</label>
          <input id="ed-email" name="email" type="email" maxlength="200" autocomplete="off" required />
          <p class="ayuda">Con este correo inicia sesión. Si lo cambias, avísale.</p>
        </div>
      </div>

      <p class="aviso rosa" id="ed-error" hidden role="alert"></p>

      <div class="acciones">
        <button type="submit" class="btn" id="ed-guardar">Guardar</button>
        <button type="button" class="btn fantasma" id="ed-cerrar">Cancelar</button>
      </div>
    </form>
  </dialog>
</Base>

<script>
  import { toast } from '@/scripts/toast';
  import { copiar } from '@/scripts/copiar';

  // ── Diálogo «Invitar» ──────────────────────────────
  const dialogo = document.getElementById('dialogo-invitar') as HTMLDialogElement;
  const forma = document.getElementById('forma-invitar') as HTMLFormElement;
  const rolSelect = document.getElementById('inv-rol') as HTMLSelectElement;
  const clienteCampo = document.getElementById('inv-cliente-campo') as HTMLElement;
  const clienteSelect = document.getElementById('inv-cliente') as HTMLSelectElement;
  const resultado = document.getElementById('inv-resultado') as HTMLElement;
  const mensaje = document.getElementById('inv-mensaje') as HTMLElement;
  const enlaceInput = document.getElementById('inv-enlace') as HTMLInputElement;
  const errorAviso = document.getElementById('inv-error') as HTMLElement;
  const enviar = document.getElementById('inv-enviar') as HTMLButtonElement;

  const puestoCampo = document.getElementById('inv-puesto-campo') as HTMLElement;
  const puestoSelect = document.getElementById('inv-puesto') as HTMLSelectElement;
  function actualizarClienteCampo() {
    const esOperador = rolSelect.value === 'operador';
    puestoCampo.hidden = !esOperador;
    puestoSelect.required = esOperador;
    const esCliente = rolSelect.value === 'cliente';
    clienteCampo.hidden = !esCliente;
    clienteSelect.required = esCliente;
  }
  rolSelect.addEventListener('change', actualizarClienteCampo);
  actualizarClienteCampo();

  function abrirDialogo() {
    forma.reset();
    actualizarClienteCampo();
    resultado.hidden = true;
    errorAviso.hidden = true;
    enviar.hidden = false;
    dialogo.showModal();
  }
  document.getElementById('abrir-invitar')!.addEventListener('click', abrirDialogo);
  document.getElementById('inv-cerrar')!.addEventListener('click', () => dialogo.close());

  const MENSAJES_ERROR: Record<string, string> = {
    'correo-invalido': 'El correo no es válido.',
    'rol-invalido': 'El rol no es válido.',
    'puesto-obligatorio': 'Elige el puesto.',
    'cliente-obligatorio': 'Elige un cliente.',
    'cliente-invalido': 'Ese cliente no existe.',
    prohibido: 'No tienes permiso para invitar con ese rol o cliente.',
    'ya-existe': 'Ya existe una cuenta con ese correo.',
    'json-invalido': 'No se pudo enviar la invitación.',
  };

  forma.addEventListener('submit', async (e) => {
    e.preventDefault();
    enviar.disabled = true;
    errorAviso.hidden = true;
    try {
      const datos = Object.fromEntries(new FormData(forma).entries()) as Record<string, string>;
      const cuerpo: Record<string, unknown> = { email: datos.email, rol: datos.rol };
      if (datos.rol === 'cliente') cuerpo.clientId = datos.clientId;
      if (datos.rol === 'operador') cuerpo.puesto = datos.puesto;

      const res = await fetch('/api/invitaciones', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cuerpo),
      });
      const json = await res.json();
      if (!res.ok || !json.ok) {
        errorAviso.textContent = MENSAJES_ERROR[json.error] ?? 'No se pudo crear la invitación.';
        errorAviso.hidden = false;
        return;
      }
      // `notaCorreo` (fix round 1 de M2): en producción sin PUBLIC_BASE_URL el
      // servidor no manda el correo y explica por qué; el enlace se copia a mano.
      mensaje.textContent = json.correoEnviado ? 'Invitación creada y enviada por correo.' : (json.notaCorreo ?? 'Invitación creada. Copia el enlace y compártelo a mano.');
      enlaceInput.value = json.enlace;
      resultado.hidden = false;
      enviar.hidden = true;
    } catch {
      errorAviso.textContent = 'No se pudo contactar al servidor.';
      errorAviso.hidden = false;
    } finally {
      enviar.disabled = false;
    }
  });

  document.getElementById('inv-copiar')!.addEventListener('click', () => copiar(enlaceInput.value, enlaceInput));

  // Una invitación nueva revoca las pendientes del mismo correo (M2 punto
  // 4): al cerrar el diálogo tras crear una, se recarga la lista.
  dialogo.addEventListener('close', () => {
    if (!resultado.hidden) window.location.reload();
  });

  // ── Revocar invitaciones de equipo pendientes (M2 punto 4).
  for (const boton of document.querySelectorAll<HTMLButtonElement>('[data-revocar-invitacion]')) {
    boton.addEventListener('click', async () => {
      boton.disabled = true;
      try {
        const res = await fetch(`/api/invitaciones?id=${encodeURIComponent(boton.dataset.revocarInvitacion ?? '')}`, { method: 'DELETE' });
        if (res.ok) {
          boton.closest('li')?.remove();
          toast('Invitación revocada');
          return;
        }
        toast('No se pudo revocar la invitación.', 'error');
      } catch {
        toast('No se pudo contactar al servidor.', 'error');
      }
      boton.disabled = false;
    });
  }

  // ── Equipo: rol y activo, cada uno con su PATCH ───
  function revertirSelect(select: HTMLSelectElement, valorAnterior: string) {
    select.value = valorAnterior;
  }

  async function patchUsuario(id: string, cambio: Record<string, unknown>) {
    try {
      const res = await fetch(`/api/admin/usuarios/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cambio),
      });
      const json = await res.json();
      // `usuario` es la fila tal como quedó guardada: el servidor recorta y
      // pasa el correo a minúsculas, así que el renglón se repinta con eso y
      // no con lo que se tecleó.
      return {
        ok: res.ok && json.ok,
        error: json.error as string | undefined,
        usuario: json.usuario as { nombre: string | null; apellido: string | null; email: string } | undefined,
      };
    } catch {
      // Sin red, servidor caído o respuesta que no es JSON: ninguno de los
      // dos listeners de abajo envolvía esta llamada, así que una falla acá
      // no revertía el control ni avisaba nada, y como nunca se llegaba al
      // 'finally' de más abajo, el select o el switch se quedaban
      // deshabilitados para siempre.
      return { ok: false, error: 'sin-conexion' };
    }
  }

  const MENSAJES_CAMBIO: Record<string, string> = {
    'solo-admin': 'Solo un admin puede hacer este cambio.',
    'rol-cliente-fijo': 'El rol de un usuario de cliente no se puede cambiar.',
    'no-autodesactivar': 'No puedes desactivarte a ti mismo.',
    'no-autodegradarse': 'No puedes quitarte tu propio rol de admin.',
    'ultimo-admin': 'Es el último admin activo: no se puede desactivar ni degradar.',
    // No «invítalo de nuevo»: POST /api/invitaciones rechaza (ya-existe) cualquier
    // correo con cuenta, y ninguna pantalla reasigna el cliente de un usuario.
    'cliente-sin-cliente': 'No se puede reactivar: esta cuenta ya no pertenece a ningún cliente. Para darle acceso a esa persona, invítala con otro correo desde la ficha del cliente.',
    'no-existe': 'Ese usuario ya no existe.',
    'puesto-obligatorio': 'Elige el puesto de esta persona.',
    'puesto-invalido': 'Ese puesto no es válido.',
    'sin-conexion': 'No se pudo contactar al servidor.',
    // Los del diálogo de edición. `correo-ocupado` llega con un 409 desde la
    // restricción única de la base.
    'correo-ocupado': 'Ese correo ya es de otra cuenta.',
    'correo-invalido': 'Ese correo no parece válido.',
    'nombre-largo': 'El nombre es demasiado largo (máximo 60 caracteres).',
    'apellido-largo': 'El apellido es demasiado largo (máximo 60 caracteres).',
  };

  const NOMBRES_PUESTO: Record<string, string> = { strategist: 'Strategist', content_creator: 'Content Creator', contenido: 'Contenido', diseno: 'Diseño', trafficker: 'Trafficker' };

  function pintarPuesto(li: HTMLElement | null, rol: string, puesto: string) {
    const t = li?.querySelector('[data-puesto-texto]');
    if (t) t.textContent = rol === 'admin' ? 'Admin' : (NOMBRES_PUESTO[puesto] ?? 'Sin puesto');
  }

  document.querySelectorAll<HTMLSelectElement>('.rol-select').forEach((select) => {
    let previo = select.value;
    const li = select.closest('li');
    const puestoSel = li?.querySelector<HTMLSelectElement>('.puesto-select') ?? null;
    select.addEventListener('change', async () => {
      const id = select.dataset.id!;
      if (select.value === 'operador') {
        // Un operador necesita puesto: se muestra el selector y el cambio de
        // rol se manda junto con el puesto, cuando se elige.
        if (puestoSel) { puestoSel.hidden = false; if (!puestoSel.value) { toast('Elige el puesto para terminar el cambio.'); return; } }
      }
      select.disabled = true;
      const cuerpo: Record<string, unknown> = { rol: select.value };
      if (select.value === 'operador' && puestoSel) cuerpo.puesto = puestoSel.value;
      const { ok, error } = await patchUsuario(id, cuerpo);
      if (ok) {
        toast('Rol actualizado');
        previo = select.value;
        if (puestoSel) puestoSel.hidden = select.value !== 'operador';
        pintarPuesto(li, select.value, puestoSel?.value ?? '');
      } else {
        toast(MENSAJES_CAMBIO[error ?? ''] ?? 'No se pudo cambiar el rol.', 'error');
        revertirSelect(select, previo);
        if (puestoSel) puestoSel.hidden = previo !== 'operador';
      }
      select.disabled = false;
    });
  });

  document.querySelectorAll<HTMLSelectElement>('.puesto-select').forEach((sel) => {
    let previo = sel.value;
    const li = sel.closest('li');
    const rolSel = li?.querySelector<HTMLSelectElement>('.rol-select') ?? null;
    sel.addEventListener('change', async () => {
      const id = sel.dataset.id!;
      sel.disabled = true;
      // Si el rol aún no era operador (cambio pendiente de elegir puesto), va junto.
      const cuerpo: Record<string, unknown> = { puesto: sel.value };
      if (rolSel && rolSel.value === 'operador') cuerpo.rol = 'operador';
      const { ok, error } = await patchUsuario(id, cuerpo);
      if (ok) {
        toast('Puesto actualizado. Se quitaron sus asignaciones de otro puesto.');
        previo = sel.value;
        pintarPuesto(li, 'operador', sel.value);
      } else {
        toast(MENSAJES_CAMBIO[error ?? ''] ?? 'No se pudo cambiar el puesto.', 'error');
        sel.value = previo;
      }
      sel.disabled = false;
    });
  });

  document.querySelectorAll<HTMLInputElement>('.activo-switch').forEach((input) => {
    let previo = input.checked;
    input.addEventListener('change', async () => {
      const id = input.dataset.id!;
      input.disabled = true;
      const { ok, error } = await patchUsuario(id, { activo: input.checked });
      if (ok) {
        toast(input.checked ? 'Usuario reactivado' : 'Usuario desactivado');
        previo = input.checked;
      } else {
        toast(MENSAJES_CAMBIO[error ?? ''] ?? 'No se pudo cambiar el estado.', 'error');
        input.checked = previo;
      }
      input.disabled = false;
    });
  });

  // ── Diálogo «Editar»: nombre, apellido y correo ────
  const dialogoEditar = document.getElementById('dialogo-editar') as HTMLDialogElement;
  const formaEditar = document.getElementById('forma-editar') as HTMLFormElement;
  const edNombre = document.getElementById('ed-nombre') as HTMLInputElement;
  const edApellido = document.getElementById('ed-apellido') as HTMLInputElement;
  const edEmail = document.getElementById('ed-email') as HTMLInputElement;
  const edError = document.getElementById('ed-error') as HTMLElement;
  const edGuardar = document.getElementById('ed-guardar') as HTMLButtonElement;

  /** El renglón que se está editando; de él salen los valores y a él vuelven. */
  let renglon: HTMLElement | null = null;

  /**
   * La misma regla que `nombreVisible` en el servidor, aquí en corto: se
   * necesita para repintar el renglón sin recargar, y `patchUsuario` solo
   * devuelve si salió bien.
   */
  const visible = (nombre: string, apellido: string, email: string) =>
    [nombre, apellido].filter(Boolean).join(' ') || email;

  // El selector se ancla a los renglones de usuario a propósito: «Guardar» y
  // «Cancelar» viven dentro del diálogo y no deben entrar aquí.
  for (const boton of document.querySelectorAll<HTMLButtonElement>('li[data-usuario-id] [data-editar]')) {
    boton.addEventListener('click', () => {
      renglon = boton.closest('li');
      if (!renglon) return;
      edNombre.value = renglon.dataset.nombre ?? '';
      edApellido.value = renglon.dataset.apellido ?? '';
      edEmail.value = renglon.dataset.email ?? '';
      edError.hidden = true;
      dialogoEditar.showModal();
    });
  }

  document.getElementById('ed-cerrar')!.addEventListener('click', () => dialogoEditar.close());
  dialogoEditar.addEventListener('close', () => { renglon = null; });

  formaEditar.addEventListener('submit', async (e) => {
    e.preventDefault();
    const li = renglon;
    if (!li) return;
    const id = li.dataset.usuarioId!;
    const nombre = edNombre.value.trim();
    const apellido = edApellido.value.trim();
    const email = edEmail.value.trim();

    edGuardar.disabled = true;
    edError.hidden = true;
    // Vacío significa borrar el dato, y por eso va como `null` y no como ''.
    const { ok, error, usuario } = await patchUsuario(id, { nombre: nombre || null, apellido: apellido || null, email });
    if (ok) {
      // Lo guardado manda sobre lo tecleado: el servidor normaliza el correo a
      // minúsculas, y sin esto el renglón mostraría una versión que no es la
      // que quedó en la base (justo el correo que el admin va a comunicar).
      const guardado = { nombre: usuario?.nombre ?? nombre, apellido: usuario?.apellido ?? apellido, email: usuario?.email ?? email };
      const titulo = visible(guardado.nombre ?? '', guardado.apellido ?? '', guardado.email);
      li.querySelector('strong')!.textContent = titulo;
      li.querySelector('[data-correo]')!.textContent = guardado.email;
      li.dataset.nombre = guardado.nombre ?? '';
      li.dataset.apellido = guardado.apellido ?? '';
      li.dataset.email = guardado.email;
      // Los controles del renglón se nombran por la persona: si cambió, sus
      // etiquetas también.
      li.querySelector('[data-editar]')?.setAttribute('aria-label', `Editar a ${titulo}`);
      li.querySelector('.rol-select')?.setAttribute('aria-label', `Rol de ${titulo}`);
      li.querySelector('.activo-switch')?.setAttribute('aria-label', `Activo: ${titulo}`);
      dialogoEditar.close();
      toast('Datos actualizados');
    } else {
      edError.textContent = MENSAJES_CAMBIO[error ?? ''] ?? 'No se pudieron guardar los datos.';
      edError.hidden = false;
    }
    edGuardar.disabled = false;
  });
</script>

<style>
  .encabezado { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .renglon-usuario { gap: 16px; }
  .renglon-usuario .cuerpo { display: flex; flex-direction: column; gap: 2px; }
  .rol-select, .puesto-select { width: auto; min-width: 130px; }
  .puesto-select[hidden] { display: none; }
  .aviso-inline { display: flex; align-items: center; gap: 6px; color: var(--amarillo); }
  .aviso-inline svg { width: 14px; height: 14px; flex-shrink: 0; }
</style>
