---
import { eq, and, desc } from 'drizzle-orm';
import { db, clientLinks, shareLinks } from '@/db';
import { renderizarManual } from '@/render/growth/manual';
import { slugificar } from '@/lib/slug';
import { baseUrlPublica } from '@/lib/base-url';
import { puedeOperarCliente } from '@/lib/permisos';
import { documentoVisible } from '@/lib/visibilidad';
import { etapaDelDocumento, permisoCompartir, barraDelDocumento } from '@/flujo/servicio';
import { puedeEditar as calcularPuedeEditar } from '@/flujo/edicion';
import { puedeComentar } from '@/flujo/reglas';
import type { FlujoDatos } from '@/render/editorial/flujo-cliente';
import { artesDelManual } from '@/growth/artes-consultas';

const usuario = Astro.locals.usuario;
const { id } = Astro.params;

const doc = await documentoVisible(usuario, 'growth', id!);
if (!doc) return new Response(null, { status: 404 });
const { resultado: r, cliente: c } = doc;
const operable = puedeOperarCliente(usuario, c);

// El destino de las URLs etiquetadas es el sitio registrado del cliente. Sin
// él la tabla de trazabilidad se declara vacía en vez de inventar enlaces.
const [sitio] = await db.select().from(clientLinks)
  .where(and(eq(clientLinks.clientId, c.id), eq(clientLinks.tipo, 'sitio'))).limit(1);

const links = operable
  ? await db.select().from(shareLinks)
      .where(and(eq(shareLinks.documentoId, r.id), eq(shareLinks.documentoTipo, 'growth')))
      .orderBy(desc(shareLinks.createdAt))
  : [];

const activo = links.find((l) => !l.revocado) ?? null;
// Misma regla que `POST /api/share` (M2 punto 1): si este usuario no puede
// crear el link, la vista interna muestra la razón en lugar del botón.
const compartir = operable ? await permisoCompartir(usuario, c.id, 'growth', r.id) : null;
// Mismo origen público que usa POST /api/share (M2 punto 4: detrás del proxy).
const base = baseUrlPublica(Astro.request);

let flujo: FlujoDatos | undefined;
if (operable) {
  const etapa = await etapaDelDocumento(c.id, 'growth', r.id);
  if (etapa) {
    const esOperadorAsignado = c.operadorId === usuario.id;
    // `etapaDelDocumento` cae a la etapa del tipo aunque este documento ya no
    // sea el vigente (B6: se puede editar una versión vieja igual). Comentar
    // es distinto (fix wave, punto 8): un ancla sobre un documento que ya no
    // es el que la etapa muestra no tiene a dónde apuntar de vuelta, así que
    // aquí se oculta el botón «Comentar» aunque el rol/etapa lo permitirían.
    const esDocumentoVigente = etapa.documentoTipo === 'growth' && etapa.documentoId === r.id;
    flujo = {
      tipo: 'growth', id: r.id, etapaId: etapa.id,
      puedeEditar: calcularPuedeEditar(usuario.rol, esOperadorAsignado, etapa.estado),
      puedeComentar: esDocumentoVigente && puedeComentar(usuario.rol, esOperadorAsignado, etapa.etapa),
      rol: usuario.rol, esOperadorAsignado,
      // La barra para avanzar la etapa desde aquí (Autorizar, Solicitar
      // autorización, Pedir cambios): las mismas reglas que la ficha.
      barra: await barraDelDocumento({ usuario, cliente: c, etapa, esDocumentoVigente }),
    };
  }
}

// El arte de los anuncios va aparte del documento (`growth_artes`): se lee el
// vigente, y solo quien puede operar al cliente recibe la API para tocarlo.
const apiArtes = `/api/growth/${r.id}/artes`;
const artes = {
  lista: await artesDelManual(r.id),
  src: (arteId: string) => `${apiArtes}/${arteId}`,
  api: operable ? apiArtes : undefined,
};

const html = renderizarManual(
  r.datos as any,
  {
    cliente: c.nombre, producto: c.producto,
    fecha: r.createdAt.toISOString().slice(0, 10),
    ciudad: c.ciudad ?? undefined,
    destino: sitio?.url,
    creadoEn: r.createdAt,
    // Vista interna, con sesión: el logo lleva al inicio del equipo.
    inicio: '/',
    artes,
  },
  // La cabecera flotante arma el botón Compartir y los de Editar/Comentar a
  // partir de estas opciones y de `flujo`: ya no se le pasa HTML armado.
  operable
    ? {
        clienteId: c.id, clienteNombre: c.nombre, clienteSlug: slugificar(c.nombre), documentoId: r.id,
        version: r.version, tipo: 'growth' as const, tokenActivo: activo?.token ?? null, base,
        razonNoCompartir: compartir && !compartir.ok ? compartir.razon : null,
      }
    : undefined,
  // No basta con `operable`: un operador viendo la etapa en revisión es
  // operable, pero no puede editar — B6, ronda de arreglos 1, punto 9.
  Boolean(flujo?.puedeEditar),
  flujo,
);
---

<Fragment set:html={html} />
