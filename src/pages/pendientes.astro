---
import Base from '@/layouts/Base.astro';
import Icono from '@/components/Icono.astro';
import { NOMBRE_ETAPA } from '@/flujo/reglas';
import { listarPendientes } from '@/lib/pendientes';
import { enlacePendiente } from '@/lib/ui/enlaces';
import { fechaCorta } from '@/lib/ui/fecha';
import { situacionPendiente, fraseComentario } from '@/flujo/situacion';

const usuario = Astro.locals.usuario;

// El cliente nunca llega aquí: rutaPermitida lo manda a /portal antes de que
// esta página se renderice (spec §6). Esta guarda es solo por si algún día
// cambia esa regla y esta página queda huérfana de protección.
if (usuario.rol === 'cliente') return Astro.redirect('/portal');

// Fix menores, punto 2: fechas del Studio en hora de México, igual que el
// portal (helper centralizado en src/lib/ui/fecha.ts).
const fecha = fechaCorta;

// Cuántos comentarios abiertos se listan de entrada (fix menores, punto 4):
// el contador de la barra lateral (`contarPendientes`, src/lib/pendientes.ts)
// suma TODOS los comentarios abiertos, sin límite, así que con más de este
// número la lista de abajo se quedaba corta contra lo que el contador
// prometía. `?comentarios=todos` levanta el límite para quien pida verlos.
const LIMITE_COMENTARIOS = 10;
const verTodosComentarios = Astro.url.searchParams.get('comentarios') === 'todos';

// Las reglas de qué espera por quién viven en src/lib/pendientes.ts, no aquí:
// el Inicio pinta lo mismo con un límite chico y no puede permitirse una
// segunda versión del criterio (etapa contratada, rol de quien mira,
// comentarios sin atender). Esta página las pide todas —las etapas no se
// paginan— y solo recorta los comentarios.
//
// `incluirEsperandoCliente` se pide solo aquí: esta es la bandeja, el sitio al
// que el operador viene a ver cómo va lo suyo. El Inicio enseña «Te toca a ti»
// y un mes esperando al cliente justamente no le toca, así que no lo pide.
const pendientes = await listarPendientes(usuario, {
  limiteComentarios: verTodosComentarios ? undefined : LIMITE_COMENTARIOS,
  incluirEsperandoCliente: true,
});

// Cada grupo se enseña por separado; `motivo` dice a cuál pertenece cada
// etapa y el orden dentro de cada lista es el que traía su consulta. El
// conteo de comentarios abiertos viene pegado a cada etapa; se rearma como
// mapa porque es así como lo indexa la plantilla, que no cambió ni una letra.
const enRevision = pendientes.etapas.filter((e) => e.motivo === 'en_revision');
const conCambios = pendientes.etapas.filter((e) => e.motivo === 'con_cambios');
const enProceso = pendientes.etapas.filter((e) => e.motivo === 'en_proceso');
// Viene en su propia lista, no en `etapas`: no cuenta en el total ni en el
// contador de la barra (src/lib/pendientes.ts, `esperaAlCliente`).
const esperandoCliente = pendientes.esperandoCliente;
const comentariosPendientes = pendientes.comentarios;
const totalComentariosPendientes = pendientes.totalComentarios;
const conteoPorEtapa = new Map<string, number>(pendientes.etapas.map((e) => [e.id, e.comentariosAbiertos]));

// Quién pidió qué y cuándo, con la misma frase que la tarjeta de la ficha y el
// Inicio (`situacionEtapa`, src/flujo/situacion.ts). Solo el texto: la lista y
// los totales son los de `listarPendientes`, sin tocar.
const ahora = new Date();
const mirada = { rol: usuario.rol === 'admin' ? 'admin' as const : 'operador' as const, usuarioId: usuario.id };
const frase = (e: (typeof pendientes.etapas)[number]) => situacionPendiente(e, mirada, ahora).resumen;
---

<Base titulo="Pendientes" activo="pendientes">
  <div class="encabezado">
    <div>
      <h1>Pendientes</h1>
      <p class="sub">
        {usuario.rol === 'admin'
          ? 'Etapas que esperan tu autorización.'
          : 'Tus etapas con cambios pedidos, en preparación, comentarios abiertos y los meses que esperan respuesta del cliente.'}
      </p>
    </div>
  </div>

  {usuario.rol === 'admin' && (
    enRevision.length === 0 ? (
      <div class="tarjeta vacio">
        <Icono nombre="vacio" />
        <strong>No hay nada en revisión</strong>
        Aparece aquí en cuanto alguien solicite autorización.
      </div>
    ) : (
      <section class="tarjeta">
        <div class="tabla-envoltura">
          <table>
            <thead>
              <tr><th>Cliente</th><th>Etapa</th><th>Solicitud</th><th>Operador</th><th></th></tr>
            </thead>
            <tbody>
              {enRevision.map((e) => (
                <tr>
                  <td>{e.cliente}</td>
                  <td>{NOMBRE_ETAPA[e.etapa]}</td>
                  <td>{frase(e)}</td>
                  <td>{e.operador ?? 'Sin asignar'}</td>
                  <td><a class="btn fantasma chico" href={enlacePendiente(e)}><Icono nombre="abrir" />Revisar</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  )}

  {usuario.rol === 'operador' && (
    <>
      <div class="seccion">
        <h2>Con cambios pedidos</h2>
        {conCambios.length === 0 ? (
          <p class="vacio">No tienes etapas con cambios pedidos.</p>
        ) : (
          <section class="tarjeta">
            <ul class="lista">
              {conCambios.map((e) => {
                const n = conteoPorEtapa.get(e.id) ?? 0;
                return (
                  <li class="renglon">
                    <div class="cuerpo">
                      <strong>{e.cliente}</strong>
                      <p class="secundario">{NOMBRE_ETAPA[e.etapa]} · {frase(e)}{n > 0 ? ` · ${n} ${n === 1 ? 'comentario abierto' : 'comentarios abiertos'}` : ''}</p>
                    </div>
                    <a href={enlacePendiente(e)} class="btn fantasma chico"><Icono nombre="abrir" />Ver</a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}
      </div>

      <div class="seccion">
        <h2>En preparación</h2>
        {enProceso.length === 0 ? (
          <p class="vacio">No tienes etapas en preparación.</p>
        ) : (
          <section class="tarjeta">
            <ul class="lista">
              {enProceso.map((e) => (
                <li class="renglon">
                  <div class="cuerpo">
                    <strong>{e.cliente}</strong>
                    <p class="secundario">{NOMBRE_ETAPA[e.etapa]} · {frase(e)}</p>
                  </div>
                  <a href={`/clientes/${e.clientId}`} class="btn fantasma chico"><Icono nombre="abrir" />Ver</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {/* No es un pendiente del operador y por eso va aparte, con su propio
          título y fuera del total: es el mes ya compartido que el cliente
          todavía no contesta. Se enseña porque el plazo corre solo y, al
          vencer, el lote se da por aprobado en silencio (diseño §6) — quien lo
          compartió querrá insistirle antes de que eso pase. El vacío no se
          pinta: un bloque «no hay nada» de algo que ni siquiera es tarea
          añadiría ruido a la bandeja. */}
      {esperandoCliente.length > 0 && (
        <div class="seccion">
          <h2>Esperando al cliente</h2>
          <p class="sub">No te toca a ti: son meses que ya compartiste y siguen sin respuesta.</p>
          <section class="tarjeta">
            <ul class="lista">
              {esperandoCliente.map((e) => (
                <li class="renglon">
                  <div class="cuerpo">
                    <strong>{e.cliente}</strong>
                    <p class="secundario">{NOMBRE_ETAPA[e.etapa]} · compartido desde {fecha(e.actualizadoEn)}</p>
                  </div>
                  <a href={`/clientes/${e.clientId}`} class="btn fantasma chico"><Icono nombre="abrir" />Ver</a>
                </li>
              ))}
            </ul>
          </section>
        </div>
      )}

      <div class="seccion" id="comentarios-abiertos">
        <h2>Comentarios abiertos{verTodosComentarios ? '' : ' recientes'} {totalComentariosPendientes > 0 && <span class="secundario">({totalComentariosPendientes})</span>}</h2>
        {comentariosPendientes.length === 0 ? (
          <p class="vacio">No hay comentarios abiertos.</p>
        ) : (
          <section class="tarjeta">
            <ul class="lista">
              {comentariosPendientes.map((c) => (
                <li class="renglon">
                  <div class="cuerpo">
                    <strong>{c.cliente}</strong>
                    <p class="secundario">{NOMBRE_ETAPA[c.etapa]} · {fraseComentario(c, mirada, ahora)}</p>
                    <p class="secundario">{c.texto}</p>
                  </div>
                  <a href={`/clientes/${c.clientId}`} class="btn fantasma chico"><Icono nombre="abrir" />Ver</a>
                </li>
              ))}
            </ul>
            {/* Fix menores, punto 4: el contador de la barra lateral suma TODOS
                los comentarios abiertos, pero la lista de arriba se corta en
                `LIMITE_COMENTARIOS` — sin este enlace, un operador con más de
                10 veía un número que nunca cuadraba con lo que la página
                mostraba, sin forma de ver el resto. */}
            {!verTodosComentarios && totalComentariosPendientes > comentariosPendientes.length && (
              <a class="btn fantasma chico" href="/pendientes?comentarios=todos#comentarios-abiertos">Ver todos ({totalComentariosPendientes})</a>
            )}
          </section>
        )}
      </div>
    </>
  )}
</Base>
