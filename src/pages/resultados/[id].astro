---
import { eq, and, desc } from 'drizzle-orm';
import { db, shareLinks } from '@/db';
import { renderizarInvestigacion } from '@/render/investigacion/documento';
import { slugificar } from '@/lib/slug';
import { puedeOperarCliente } from '@/lib/permisos';
import { documentoVisible } from '@/lib/visibilidad';
import { etapaDelDocumento } from '@/flujo/servicio';
import { puedeEditar as calcularPuedeEditar } from '@/flujo/edicion';
import { puedeComentar } from '@/flujo/reglas';
import type { FlujoDatos } from '@/render/editorial/flujo-cliente';

const usuario = Astro.locals.usuario;
const { id } = Astro.params;

const doc = await documentoVisible(usuario, 'research', id!);
if (!doc) return new Response(null, { status: 404 });
const { resultado: r, cliente: c } = doc;
const operable = puedeOperarCliente(usuario, c);

const links = operable
  ? await db.select().from(shareLinks)
      .where(and(eq(shareLinks.documentoId, r.id), eq(shareLinks.documentoTipo, 'research')))
      .orderBy(desc(shareLinks.createdAt))
  : [];

const activo = links.find((l) => !l.revocado) ?? null;
const base = (process.env.PUBLIC_BASE_URL ?? Astro.url.origin).replace(/\/+$/, '');

// Vista interna (B6, spec §3): `data-editable`/`data-flujo` y SCRIPT_FLUJO
// solo cuando `operable` — la vista pública y el portal nunca los llevan.
let flujo: FlujoDatos | undefined;
if (operable) {
  const etapa = await etapaDelDocumento(c.id, 'research', r.id);
  if (etapa) {
    const esOperadorAsignado = c.operadorId === usuario.id;
    flujo = {
      tipo: 'research', id: r.id, etapaId: etapa.id,
      puedeEditar: calcularPuedeEditar(usuario.rol, esOperadorAsignado, etapa.estado),
      puedeComentar: puedeComentar(usuario.rol, esOperadorAsignado, etapa.etapa),
      rol: usuario.rol, esOperadorAsignado,
    };
  }
}

// La cabecera de la investigación trae su propio botón Compartir; sin permiso
// de operar, se le pasa `undefined` y esa cabecera queda como la ve el cliente.
const html = renderizarInvestigacion(
  r.datos as any,
  { cliente: c.nombre, giro: c.giro, fecha: r.createdAt.toISOString().slice(0, 10) },
  operable
    ? {
        clienteId: c.id, clienteNombre: c.nombre, clienteSlug: slugificar(c.nombre), documentoId: r.id,
        version: r.version, tipo: 'research', tokenActivo: activo?.token ?? null, base,
      }
    : undefined,
  // `data-editable` solo cuando este usuario, en el estado ACTUAL de la
  // etapa, puede editar — no basta con `operable` (un operador viendo un
  // documento en revisión es operable, pero no puede editar) — B6, ronda de
  // arreglos 1, punto 9.
  Boolean(flujo?.puedeEditar),
  flujo,
  // `data-ancla` en la vista interna, nunca en la pública/portal — igual
  // que `data-editable`, pero gobernado por `operable` (B7, spec §3): el
  // personal siempre puede comentar aunque no pueda editar en este momento.
  Boolean(flujo),
);
---

<Fragment set:html={html} />
