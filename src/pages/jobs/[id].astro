---
import { eq } from 'drizzle-orm';
import Base from '@/layouts/Base.astro';
import ProgresoJob from '@/components/ProgresoJob';
import { db, researchResults, growthResults, pilaresResults } from '@/db';
import { jobVisible } from '@/lib/visibilidad';

const usuario = Astro.locals.usuario;
const { id } = Astro.params;

const visible = await jobVisible(usuario, id!);
if (!visible) return new Response(null, { status: 404 });
const { job, cliente } = visible;
// El resultado vive en una tabla u otra según el tipo del job.
const tabla = job.tipo === 'growth' ? growthResults : job.tipo === 'pilares' ? pilaresResults : researchResults;
const [resultado] = await db.select({ id: tabla.id }).from(tabla).where(eq(tabla.jobId, job.id)).limit(1);

const esGrowth = job.tipo === 'growth';
const esPilares = job.tipo === 'pilares';
const eyebrow = esGrowth ? 'Manual de campaña' : esPilares ? 'Mapa de pilares' : 'Social Research';
const titulo = esGrowth ? 'Manual de campaña' : esPilares ? 'Mapa de pilares' : 'Investigación';
const tope = Number(process.env.COST_LIMIT_USD || 15);

const inicial = {
  ok: true,
  estado: job.estado,
  etapaActual: job.etapaActual,
  etapas: (job.etapas ?? {}) as Record<string, string>,
  costoUsd: Number(job.costoUsd),
  error: job.error,
  tipo: job.tipo,
  resultId: resultado?.id ?? null,
  startedAt: job.startedAt?.toISOString() ?? null,
  finishedAt: job.finishedAt?.toISOString() ?? null,
};
---

<Base
  titulo={`${titulo} · ${cliente?.nombre ?? ''}`}
  activo="clientes"
  volver={{ href: `/clientes/${job.clientId}`, texto: cliente?.nombre ?? 'Cliente' }}
>
  <div class="encabezado">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{cliente?.nombre}</h1>
      <p class="sub">La página se actualiza sola cada tres segundos.</p>
    </div>
  </div>
  <ProgresoJob client:load jobId={job.id} inicial={inicial} tope={tope} />
</Base>
