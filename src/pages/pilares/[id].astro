---
import { eq, and, desc } from 'drizzle-orm';
import { db, pilaresTemas, shareLinks, users } from '@/db';
import { renderizarPilares } from '@/render/pilares/documento';
import { slugificar } from '@/lib/slug';
import { baseUrlPublica } from '@/lib/base-url';
import { puedeOperarCliente } from '@/lib/permisos';
import { nombreVisible } from '@/lib/usuarios';
import { documentoVisible } from '@/lib/visibilidad';
import { etapaDelDocumento, permisoCompartir } from '@/flujo/servicio';
import { puedeEditar as calcularPuedeEditar } from '@/flujo/edicion';
import { puedeComentar } from '@/flujo/reglas';
import type { FlujoDatos } from '@/render/editorial/flujo-cliente';
import type { AvanceTema } from '@/pilares/avance';

const usuario = Astro.locals.usuario;
const { id } = Astro.params;

const doc = await documentoVisible(usuario, 'pilares', id!);
if (!doc) return new Response(null, { status: 404 });
const { resultado: r, cliente: c } = doc;
const operable = puedeOperarCliente(usuario, c);

const links = operable
  ? await db.select().from(shareLinks)
      .where(and(eq(shareLinks.documentoId, r.id), eq(shareLinks.documentoTipo, 'pilares')))
      .orderBy(desc(shareLinks.createdAt))
  : [];

const activo = links.find((l) => !l.revocado) ?? null;
// Misma regla que `POST /api/share` (M2 punto 1): si este usuario no puede
// crear el link, la vista interna muestra la razón en lugar del botón.
const compartir = operable ? await permisoCompartir(usuario, c.id, 'pilares', r.id) : null;
// Mismo origen público que usa POST /api/share (M2 punto 4: detrás del proxy).
const base = baseUrlPublica(Astro.request);

const filas = await db
  .select({
    temaId: pilaresTemas.temaId, estado: pilaresTemas.estado, nota: pilaresTemas.nota, actualizadoEn: pilaresTemas.actualizadoEn,
    autorNombre: users.nombre, autorApellido: users.apellido, autorEmail: users.email,
  })
  .from(pilaresTemas)
  .leftJoin(users, eq(users.id, pilaresTemas.actualizadoPor))
  .where(eq(pilaresTemas.resultId, r.id));

const avance: Record<string, AvanceTema> = {};
for (const f of filas) {
  avance[f.temaId] = {
    estado: f.estado as AvanceTema['estado'],
    nota: f.nota,
    // El `leftJoin` deja las tres columnas en null a la vez cuando nadie tocó
    // el tema o su autor ya no existe; se detecta por el correo, que es la
    // única que nunca está vacía en una fila real.
    actualizadoPor: f.autorEmail === null ? null : nombreVisible({ nombre: f.autorNombre, apellido: f.autorApellido, email: f.autorEmail }),
    actualizadoEn: f.actualizadoEn.toISOString(),
  };
}

let flujo: FlujoDatos | undefined;
if (operable) {
  const etapa = await etapaDelDocumento(c.id, 'pilares', r.id);
  if (etapa) {
    const esOperadorAsignado = c.operadorId === usuario.id;
    // `etapaDelDocumento` cae a la etapa del tipo aunque este documento ya no
    // sea el vigente (B6: se puede editar una versión vieja igual). Comentar
    // es distinto (fix wave, punto 8): un ancla sobre un documento que ya no
    // es el que la etapa muestra no tiene a dónde apuntar de vuelta, así que
    // aquí se oculta el botón «Comentar» aunque el rol/etapa lo permitirían.
    const esDocumentoVigente = etapa.documentoTipo === 'pilares' && etapa.documentoId === r.id;
    flujo = {
      tipo: 'pilares', id: r.id, etapaId: etapa.id,
      puedeEditar: calcularPuedeEditar(usuario.rol, esOperadorAsignado, etapa.estado),
      puedeComentar: esDocumentoVigente && puedeComentar(usuario.rol, esOperadorAsignado, etapa.etapa),
      rol: usuario.rol, esOperadorAsignado,
    };
  }
}

const html = renderizarPilares(
  r.datos as any,
  // `inicio`: vista interna, con sesión — el logo lleva al inicio del equipo.
  { cliente: c.nombre, fecha: r.createdAt.toISOString().slice(0, 10), inicio: '/' },
  {
    operador: operable
      ? {
          clienteId: c.id, clienteNombre: c.nombre, clienteSlug: slugificar(c.nombre), documentoId: r.id,
          version: r.version, tipo: 'pilares', tokenActivo: activo?.token ?? null, base,
          razonNoCompartir: compartir && !compartir.ok ? compartir.razon : null,
        }
      : undefined,
    avance,
    resultId: r.id,
    // No basta con `operable`: un operador viendo la etapa en revisión es
    // operable, pero no puede editar — B6, ronda de arreglos 1, punto 9.
    editable: Boolean(flujo?.puedeEditar),
    // `data-ancla` en la vista interna (B7): gobernado por `operable`, no
    // por `puedeEditar` — el personal siempre puede comentar aunque no
    // pueda editar en este momento.
    anclas: Boolean(flujo),
    flujo,
  },
);
---

<Fragment set:html={html} />
