---
import { eq, and, desc } from 'drizzle-orm';
import { db, pilaresTemas, shareLinks, users } from '@/db';
import { renderizarPilares } from '@/render/pilares/documento';
import { slugificar } from '@/lib/slug';
import { puedeOperarCliente } from '@/lib/permisos';
import { documentoVisible } from '@/lib/visibilidad';
import { etapaDelDocumento } from '@/flujo/servicio';
import { puedeEditar as calcularPuedeEditar } from '@/flujo/edicion';
import { puedeComentar } from '@/flujo/reglas';
import type { FlujoDatos } from '@/render/editorial/flujo-cliente';
import type { AvanceTema } from '@/pilares/avance';

const usuario = Astro.locals.usuario;
const { id } = Astro.params;

const doc = await documentoVisible(usuario, 'pilares', id!);
if (!doc) return new Response(null, { status: 404 });
const { resultado: r, cliente: c } = doc;
const operable = puedeOperarCliente(usuario, c);

const links = operable
  ? await db.select().from(shareLinks)
      .where(and(eq(shareLinks.documentoId, r.id), eq(shareLinks.documentoTipo, 'pilares')))
      .orderBy(desc(shareLinks.createdAt))
  : [];

const activo = links.find((l) => !l.revocado) ?? null;
const base = (process.env.PUBLIC_BASE_URL ?? Astro.url.origin).replace(/\/+$/, '');

const filas = await db
  .select({ temaId: pilaresTemas.temaId, estado: pilaresTemas.estado, nota: pilaresTemas.nota, actualizadoEn: pilaresTemas.actualizadoEn, actualizadoPor: users.email })
  .from(pilaresTemas)
  .leftJoin(users, eq(users.id, pilaresTemas.actualizadoPor))
  .where(eq(pilaresTemas.resultId, r.id));

const avance: Record<string, AvanceTema> = {};
for (const f of filas) {
  avance[f.temaId] = {
    estado: f.estado as AvanceTema['estado'],
    nota: f.nota,
    actualizadoPor: f.actualizadoPor,
    actualizadoEn: f.actualizadoEn.toISOString(),
  };
}

let flujo: FlujoDatos | undefined;
if (operable) {
  const etapa = await etapaDelDocumento(c.id, 'pilares', r.id);
  if (etapa) {
    const esOperadorAsignado = c.operadorId === usuario.id;
    flujo = {
      tipo: 'pilares', id: r.id, etapaId: etapa.id,
      puedeEditar: calcularPuedeEditar(usuario.rol, esOperadorAsignado, etapa.estado),
      puedeComentar: puedeComentar(usuario.rol, esOperadorAsignado, etapa.etapa),
    };
  }
}

const html = renderizarPilares(
  r.datos as any,
  { cliente: c.nombre, fecha: r.createdAt.toISOString().slice(0, 10) },
  {
    operador: operable
      ? {
          clienteId: c.id, clienteNombre: c.nombre, clienteSlug: slugificar(c.nombre), documentoId: r.id,
          version: r.version, tipo: 'pilares', tokenActivo: activo?.token ?? null, base,
        }
      : undefined,
    avance,
    resultId: r.id,
    editable: operable,
    flujo,
  },
);
---

<Fragment set:html={html} />
