---
import { and, asc, eq, gte, inArray, ne } from 'drizzle-orm';
import Base from '@/layouts/Base.astro';
import Icono from '@/components/Icono.astro';
import { db, clients, clienteEtapas, etapaEventos, comentarios, researchJobs, users } from '@/db';
import { condicionClientes, esUuid } from '@/lib/visibilidad';
import { nombreVisible, ordenUsuarios } from '@/lib/usuarios';
import { ETAPAS, NOMBRE_ETAPA, avanceCliente, type Etapa, type Estado } from '@/flujo/reglas';
import {
  periodo, resumenEstadistico, tiemposPorEtapa, calidad, carga, costo, operadorDeJob,
  enPeriodoCerrado, agruparClientesPorOperador, desglosePorEtapa,
  type Evento, type ComentarioM, type JobM, type EtapaM, type Periodo,
} from '@/lib/desempeno';
import { graficaBarras, type FilaGrafica } from '@/render/investigacion/graficas';

// El middleware ya manda al cliente a /portal antes de llegar aquí
// (rutaPermitida en src/lib/permisos.ts no incluye /desempeno entre las
// rutas del cliente). Esta guarda es solo por si esa regla cambia algún día.
const usuario = Astro.locals.usuario;
if (usuario.rol === 'cliente') return Astro.redirect('/portal');

const esAdmin = usuario.rol === 'admin';

// ── Periodo ──────────────────────────────────────────────────────────────
const CLAVES_PERIODO = ['mes', 'mes_anterior', '90', 'todo'] as const;
type ClavePeriodo = (typeof CLAVES_PERIODO)[number];
const periodoParam = Astro.url.searchParams.get('periodo');
const claveActiva: ClavePeriodo = (CLAVES_PERIODO as readonly string[]).includes(periodoParam ?? '')
  ? (periodoParam as ClavePeriodo)
  : 'mes';
const periodoActual: Periodo = periodo(claveActiva, new Date());

const PERIODOS: { clave: ClavePeriodo; texto: string }[] = [
  { clave: 'mes', texto: 'Este mes' },
  { clave: 'mes_anterior', texto: 'Mes anterior' },
  { clave: '90', texto: 'Últimos 90 días' },
  { clave: 'todo', texto: 'Todo' },
];

// ── Alcance (clientes visibles) ─────────────────────────────────────────
// Solo el admin puede acotar por operador; para el operador, `?operador=`
// se ignora (condicionClientes ya lo deja viendo solo lo suyo).
const operadorParam = esAdmin ? (Astro.url.searchParams.get('operador') ?? '') : '';
const operadorFiltro = esUuid(operadorParam) ? operadorParam : '';
const cond = operadorFiltro ? eq(clients.operadorId, operadorFiltro) : condicionClientes(usuario);

const lista = await db.select().from(clients).where(cond).orderBy(asc(clients.nombre));
const ids = lista.map((c) => c.id);
const operadorDeCliente = new Map(lista.map((c) => [c.id, c.operadorId]));

function enlacePeriodo(clave: ClavePeriodo): string {
  const params = new URLSearchParams({ periodo: clave });
  if (operadorFiltro) params.set('operador', operadorFiltro);
  return `/desempeno?${params.toString()}`;
}

// Solo admin ve el select, y lo ve aunque el filtro actual no traiga
// resultados (para poder quitarlo). Solo admin/operador activos (fix wave,
// #10): un usuario inactivo ya no puede tener clientes propios, y listarlo
// aquí solo confundiría el filtro.
// El orden es de personas, no de una columna: se hace en memoria con
// `ordenUsuarios` (apellido, nombre, y al final quien aún no tenga ninguno).
const operadoresSelect = esAdmin
  ? (await db.select({ id: users.id, nombre: users.nombre, apellido: users.apellido, email: users.email })
      .from(users).where(and(ne(users.rol, 'cliente'), eq(users.activo, true)))).sort(ordenUsuarios)
  : [];
const nombreOperador = new Map<string, string>(
  esAdmin ? operadoresSelect.map((o) => [o.id, nombreVisible(o)]) : [[usuario.id, nombreVisible(usuario)]],
);

// ── Consulta (una sola vez por tabla, nunca por cliente) ────────────────
const etapasFilas = ids.length
  ? await db
      .select({
        id: clienteEtapas.id, clientId: clienteEtapas.clientId, etapa: clienteEtapas.etapa,
        estado: clienteEtapas.estado, contratada: clienteEtapas.contratada, interna: clienteEtapas.interna,
      })
      .from(clienteEtapas)
      .where(inArray(clienteEtapas.clientId, ids))
  : [];
const etapas: EtapaM[] = etapasFilas.map((e) => ({ ...e, operadorId: operadorDeCliente.get(e.clientId) ?? null }));

const eventosFilas = ids.length
  ? await db
      .select({
        etapaId: etapaEventos.etapaId, clientId: clienteEtapas.clientId, etapa: clienteEtapas.etapa,
        accion: etapaEventos.accion, de: etapaEventos.de, a: etapaEventos.a, creadoEn: etapaEventos.creadoEn,
      })
      .from(etapaEventos)
      .innerJoin(clienteEtapas, eq(clienteEtapas.id, etapaEventos.etapaId))
      .where(inArray(clienteEtapas.clientId, ids))
  : [];
const eventos: Evento[] = eventosFilas;

const comentariosFilas = ids.length
  ? await db
      .select({ etapaId: comentarios.etapaId, autorRol: comentarios.autorRol, creadoEn: comentarios.creadoEn })
      .from(comentarios)
      .innerJoin(clienteEtapas, eq(clienteEtapas.id, comentarios.etapaId))
      .where(inArray(clienteEtapas.clientId, ids))
  : [];
const comentariosM: ComentarioM[] = comentariosFilas;

// Solo las columnas que usa `costo()`, y acotado por `desde` cuando el
// periodo lo tiene (fix wave, #10): a diferencia de los eventos —que
// necesitan el historial completo para emparejar duraciones que empezaron
// antes del periodo—, un job fuera de rango nunca cuenta para `costo()`
// (que sí filtra por periodo), así que no hace falta traerlo.
const jobsFilas = ids.length
  ? await db
      .select({ clientId: researchJobs.clientId, tipo: researchJobs.tipo, costoUsd: researchJobs.costoUsd, creadoPor: researchJobs.creadoPor, createdAt: researchJobs.createdAt })
      .from(researchJobs)
      .where(
        periodoActual.desde
          ? and(inArray(researchJobs.clientId, ids), gte(researchJobs.createdAt, periodoActual.desde))
          : inArray(researchJobs.clientId, ids),
      )
  : [];
// costo_usd es numeric: postgres-js lo entrega como string. Un valor corrupto
// cuenta como 0 en vez de volver NaN todas las sumas del tablero.
const jobs: JobM[] = jobsFilas.map((j) => {
  const n = Number(j.costoUsd);
  return { clientId: j.clientId, tipo: j.tipo, costoUsd: Number.isNaN(n) ? 0 : n, creadoPor: j.creadoPor, creadoEn: j.createdAt };
});

// ── Métricas (funciones puras de src/lib/desempeno.ts) ──────────────────
// tiemposPorEtapa y calidad no reciben periodo (ver su firma en D1: no
// toman un Periodo), así que el recorte se hace con `enPeriodoCerrado`
// (tarea I4, punto 2: extraída de esta página a la librería, con pruebas
// propias). Con periodo !== 'todo' se calculan solo sobre las etapas
// "cerradas" en el periodo (con un evento 'aprobar' dentro del rango),
// pasando el historial completo de esas etapas — así duracion,
// esperaRevision y respuestaCambios siguen emparejando eventos de la misma
// etapaId como espera tiemposPorEtapa, en vez de cortar por fecha de cada
// evento suelto. Con 'todo' no hace falta filtrar: ya es todo el historial.
const esTodo = claveActiva === 'todo';

const cargaRes = carga(etapas, eventos, periodoActual);
const costoRes = costo(jobs, operadorDeCliente, periodoActual);
const { eventos: eventosCerrados, comentarios: comentariosCerrados } = enPeriodoCerrado(eventos, comentariosM, periodoActual, esTodo);
const tiemposRes = tiemposPorEtapa(eventosCerrados);
const calidadRes = calidad(eventosCerrados, comentariosCerrados);

// ── Formato de números (spec: días «4.2 días», dinero «$12.34 USD», % «63%») ──
const dias = (n: number | null) => (n === null ? '—' : `${n.toFixed(1)} días`);
const dinero = (n: number) => `$${n.toFixed(2)} USD`;
const pct = (n: number) => `${Math.round(n)}%`;

// §5: promedio y mediana de cada métrica de tiempo, sobre las etapas
// "cerradas" en el periodo (enPeriodoCerrado arriba). resumenEstadistico ya
// trae la mediana (D1); antes solo se leía `.promedio` de dos de las tres, y
// la respuesta a cambios y los comentarios por entregable no se mostraban
// en ningún lado de la página (fix wave, #4).
const diasAprobarRes = resumenEstadistico(Object.values(tiemposRes.duracion).flat());
const esperaRevisionRes = resumenEstadistico(tiemposRes.esperaRevision);
const respuestaCambiosRes = resumenEstadistico(tiemposRes.respuestaCambios);
const rondasProm = resumenEstadistico(calidadRes.rondasPorEtapaAprobada).promedio;

// ── Estados vacíos (tarea I4, punto 3): "sin clientes" y "sin actividad en
// este periodo" son cosas distintas y antes compartían el mismo mensaje
// ("Todavía no hay actividad en este periodo"), incluso cuando la causa real
// era que no había NINGÚN cliente visible (por el filtro de operador, o
// porque de plano no hay clientes dados de alta). `sinClientes` manda: sin
// clientes no hay nada que mostrar sin importar el periodo. `sinActividad`
// solo aplica cuando SÍ hay clientes pero ninguno tuvo movimiento (etapas,
// aprobaciones, costo o tiempos) dentro del periodo elegido.
const sinClientes = lista.length === 0;
const sinActividad = !sinClientes
  && cargaRes.etapasActivas === 0 && cargaRes.aprobadasEnPeriodo === 0 && costoRes.total === 0
  && diasAprobarRes.n === 0 && esperaRevisionRes.n === 0 && respuestaCambiosRes.n === 0;

// ── Barras ────────────────────────────────────────────────────────────
const filasDias: FilaGrafica[] = [];
for (const et of ETAPAS) {
  const r = resumenEstadistico(tiemposRes.duracion[et]);
  if (r.promedio !== null) filasDias.push({ nombre: NOMBRE_ETAPA[et], min: r.promedio, max: r.promedio, destacada: false });
}
const graficaDiasHtml = graficaBarras(filasDias, 'Días promedio por etapa', (n) => dias(n));

const NOMBRE_TIPO: Record<'research' | 'pilares' | 'growth' | 'contenido', string> = {
  research: 'Investigación', pilares: 'Mapa de pilares', growth: 'Manual de campaña', contenido: 'Contenido del mes con IA',
};
const filasCosto: FilaGrafica[] = (['research', 'pilares', 'growth', 'contenido'] as const).map((t) => ({
  nombre: NOMBRE_TIPO[t], min: costoRes.porEtapa[t], max: costoRes.porEtapa[t], destacada: false,
}));
// Formateador de dinero USD con 2 decimales (fix wave, #3): sin pasarlo,
// graficaBarras usaba su formateador por omisión (formatearMonto, pesos sin
// decimales), que no coincidía ni con costo_usd ni con las tarjetas de arriba.
const graficaCostoHtml = costoRes.total > 0 ? graficaBarras(filasCosto, 'Costo por tipo', dinero) : '';

// ── Tabla «Por operador» y desglose operador × etapa (admin) ─────────────
// Agrupación por operador movida a la librería (tarea I4, punto 2):
// `agruparClientesPorOperador` es la misma función pura que usa su propia
// prueba en tests/lib/desempeno.test.ts, en vez de reconstruir el Map aquí.
const ORDEN_ETAPA = new Map(ETAPAS.map((e, i) => [e, i]));
const clientIdDeEtapaId = new Map(etapas.map((e) => [e.id, e.clientId]));

const gruposOperador = agruparClientesPorOperador(lista);

const filasPorOperador = [...gruposOperador.entries()]
  .map(([clave, clientIds]) => {
    const idsSet = new Set(clientIds);
    const nombre = clave === 'sin_asignar' ? 'Sin asignar' : (nombreOperador.get(clave) ?? 'Operador');
    const etapasG = etapas.filter((e) => idsSet.has(e.clientId));
    const eventosG = eventos.filter((e) => idsSet.has(e.clientId));
    const comentariosG = comentariosM.filter((c) => idsSet.has(clientIdDeEtapaId.get(c.etapaId) ?? ''));
    const cargaG = carga(etapasG, eventosG, periodoActual);
    const { eventos: eventosGCerrados, comentarios: comentariosGCerrados } = enPeriodoCerrado(eventosG, comentariosG, periodoActual, esTodo);
    const diasG = resumenEstadistico(Object.values(tiemposPorEtapa(eventosGCerrados).duracion).flat()).promedio;
    const rondasG = resumenEstadistico(calidad(eventosGCerrados, comentariosGCerrados).rondasPorEtapaAprobada).promedio;
    // clientes: el tamaño real del grupo, no el conteo de carga() (distinto de
    // los clientId presentes en etapasG; deberían coincidir siempre que cada
    // cliente tenga sus 4 filas de cliente_etapas, pero idsSet.size es la
    // fuente de verdad — es la misma lista que arma la fila de cada operador).
    return { clave, nombre, ...cargaG, clientes: idsSet.size, dias: diasG, rondas: rondasG, costo: costoRes.porOperador.get(clave) ?? 0 };
  })
  .sort((a, b) => (a.nombre === 'Sin asignar' ? 1 : b.nombre === 'Sin asignar' ? -1 : a.nombre.localeCompare(b.nombre, 'es')));

// Desglose operador × etapa (tarea I4, punto 2): días (mediana), rondas
// (promedio) y costo por etapa, para cada operador. El costo usa la misma
// atribución por creado_por que costoRes.porOperador arriba (con el
// operador del cliente como respaldo) — no la lista de clientes asignados
// hoy — para no mostrar dos definiciones distintas de "costo por operador"
// en la misma página; días y rondas sí usan la asignación actual (mismo
// criterio que el resto de esta tabla).
const filasDesgloseOperador = filasPorOperador.map((f) => {
  const idsSet = new Set(gruposOperador.get(f.clave) ?? []);
  const operadorIdReal = f.clave === 'sin_asignar' ? null : f.clave;
  const eventosGCerrados = eventosCerrados.filter((e) => idsSet.has(e.clientId));
  const jobsAtribuidos = jobs.filter((j) => operadorDeJob(j, operadorDeCliente) === operadorIdReal);
  return { nombre: f.nombre, porEtapa: desglosePorEtapa(eventosGCerrados, jobsAtribuidos) };
});

// ── Tabla «Por cliente» ──────────────────────────────────────────────────
// avanceDeCliente propia (que SÍ contaba desarrollo_mensual) se quita: esta
// columna ahora reutiliza avanceCliente de src/flujo/reglas.ts, la misma
// función que ya usa el portal del cliente (M3, punto 7 del controlador) y
// que ahora también usa carga() más arriba (punto 6) — las tres pantallas
// muestran el mismo % para el mismo cliente.
function etapaActualDe(etapasCliente: EtapaM[]): string {
  const visibles = etapasCliente
    .filter((e) => e.contratada && !e.interna)
    .sort((a, b) => (ORDEN_ETAPA.get(a.etapa) ?? 0) - (ORDEN_ETAPA.get(b.etapa) ?? 0));
  if (visibles.length === 0) return '—';
  const actual = visibles.find((e) => e.estado !== 'aprobada');
  return actual ? NOMBRE_ETAPA[actual.etapa] : 'Completado';
}

const etapasPorCliente = new Map<string, EtapaM[]>();
for (const e of etapas) {
  const l = etapasPorCliente.get(e.clientId);
  if (l) l.push(e);
  else etapasPorCliente.set(e.clientId, [e]);
}

const filasPorCliente = lista.map((c) => ({
  nombre: c.nombre,
  avance: avanceCliente(etapasPorCliente.get(c.id) ?? []),
  etapaActual: etapaActualDe(etapasPorCliente.get(c.id) ?? []),
  operador: c.operadorId ? (nombreOperador.get(c.operadorId) ?? 'Operador') : 'Sin asignar',
  costo: costoRes.porCliente.get(c.id) ?? 0,
}));

// Desglose cliente × etapa (tarea I4, punto 2): días (mediana), rondas
// (promedio) y costo por etapa, para cada cliente. Aquí el costo sí es por
// `clientId` sin importar quién corrió el job (a diferencia del desglose por
// operador arriba): del lado del cliente no hay ambigüedad de atribución.
const jobsPorCliente = new Map<string, JobM[]>();
for (const j of jobs) {
  const l = jobsPorCliente.get(j.clientId);
  if (l) l.push(j);
  else jobsPorCliente.set(j.clientId, [j]);
}
const filasDesgloseCliente = lista.map((c) => ({
  nombre: c.nombre,
  porEtapa: desglosePorEtapa(eventosCerrados.filter((e) => e.clientId === c.id), jobsPorCliente.get(c.id) ?? []),
}));

// Formato de una celda del desglose por etapa: "días · rondas · costo",
// reutilizando los formateadores de arriba (`dias`, `dinero`).
function textoRondas(n: number | null): string {
  return n === null ? '—' : `${n.toFixed(1)} rondas`;
}
---

<Base titulo="Desempeño" activo="desempeno">
  <div class="encabezado">
    <div>
      <h1>Desempeño</h1>
      <p class="sub">Tiempos, calidad, carga y costo por operador y por cliente.</p>
    </div>
  </div>

  <nav class="chips" aria-label="Filtrar por periodo">
    {PERIODOS.map((p) => (
      <a href={enlacePeriodo(p.clave)} class:list={['chip', { activo: claveActiva === p.clave }]} aria-current={claveActiva === p.clave ? 'page' : undefined}>
        {p.texto}
      </a>
    ))}
  </nav>

  {esAdmin && operadoresSelect.length > 0 && (
    <form method="GET" id="operador-form" class="campo" style="max-width:280px;margin-bottom:22px;display:flex;flex-direction:row;align-items:flex-end;gap:10px">
      <div style="flex:1;min-width:0">
        <label for="operador-filtro">Operador</label>
        <input type="hidden" name="periodo" value={claveActiva} />
        <select id="operador-filtro" name="operador">
          <option value="">Todos</option>
          {operadoresSelect.map((o) => <option value={o.id} selected={o.id === operadorFiltro}>{nombreVisible(o)}</option>)}
        </select>
      </div>
      {/* El cambio de select se manda solo por JS (abajo); este botón es el
         camino sin JS — visible siempre, no solo en <noscript>, porque no
         estorba y cubre también a quien prefiera no depender del cambio
         automático. */}
      <button type="submit" class="btn fantasma chico">Aplicar</button>
    </form>
  )}

  {sinClientes ? (
    <div class="tarjeta vacio">
      <Icono nombre="clientes" />
      <strong>Todavía no hay clientes</strong>
      {operadorFiltro ? 'Ese operador no tiene clientes asignados.' : 'En cuanto haya clientes dados de alta, aparecen aquí.'}
    </div>
  ) : sinActividad ? (
    <div class="tarjeta vacio">
      <Icono nombre="grafica" />
      <strong>Todavía no hay actividad en este periodo</strong>
      Prueba con otro periodo, o vuelve cuando haya movimiento en las etapas.
    </div>
  ) : (
    <>
      <section class="indicadores" aria-label="Carga y avance">
        <div class="indicador rosa"><Icono nombre="clientes" /><span class="valor cifra">{lista.length}</span><span class="nombre">Clientes</span></div>
        <div class="indicador azul"><Icono nombre="reloj" /><span class="valor cifra">{cargaRes.etapasActivas}</span><span class="nombre">Etapas activas</span></div>
        <div class="indicador verde"><Icono nombre="grafica" /><span class="valor cifra">{pct(cargaRes.avancePromedio)}</span><span class="nombre">Avance promedio</span></div>
        <div class="indicador amarillo"><Icono nombre="check" /><span class="valor cifra">{cargaRes.aprobadasEnPeriodo}</span><span class="nombre">Aprobadas en el periodo</span></div>
      </section>

      <section class="indicadores" aria-label="Tiempos, calidad y costo" style="margin-top:12px">
        <div class="indicador rosa"><Icono nombre="reloj" /><span class="valor cifra">{dias(diasAprobarRes.promedio)}</span><span class="nombre">Días promedio a aprobar</span></div>
        <div class="indicador azul"><Icono nombre="reloj" /><span class="valor cifra">{dias(esperaRevisionRes.promedio)}</span><span class="nombre">Espera promedio en revisión</span></div>
        <div class="indicador amarillo"><Icono nombre="alerta" /><span class="valor cifra">{rondasProm === null ? '—' : rondasProm.toFixed(1)}</span><span class="nombre">Rondas de cambios promedio</span></div>
        <div class="indicador verde"><Icono nombre="dinero" /><span class="valor cifra">{dinero(costoRes.total)}</span><span class="nombre">Costo del periodo</span></div>
      </section>
      <p class="secundario" style="margin-top:10px">Tiempos y rondas de las etapas aprobadas en el periodo.</p>

      <section class="seccion">
        <h2>Días y costo por etapa</h2>
        <div class="rejilla">
          {graficaDiasHtml
            ? <Fragment set:html={graficaDiasHtml} />
            : <div class="tarjeta vacio"><Icono nombre="grafica" /><strong>Todavía no hay actividad en este periodo</strong>Faltan etapas aprobadas para comparar días por etapa.</div>}
          {graficaCostoHtml
            ? <Fragment set:html={graficaCostoHtml} />
            : <div class="tarjeta vacio"><Icono nombre="dinero" /><strong>Todavía no hay actividad en este periodo</strong>Sin costo registrado en el periodo elegido.</div>}
        </div>
      </section>

      <section class="seccion">
        <h2>Detalle de tiempos y calidad</h2>
        <section class="tarjeta">
          <div class="tabla-envoltura">
            <table>
              <thead>
                <tr><th>Métrica</th><th>Promedio</th><th>Mediana</th></tr>
              </thead>
              <tbody>
                <tr><td>Días a aprobar</td><td>{dias(diasAprobarRes.promedio)}</td><td>{dias(diasAprobarRes.mediana)}</td></tr>
                <tr><td>Espera en revisión</td><td>{dias(esperaRevisionRes.promedio)}</td><td>{dias(esperaRevisionRes.mediana)}</td></tr>
                <tr><td>Respuesta a cambios</td><td>{dias(respuestaCambiosRes.promedio)}</td><td>{dias(respuestaCambiosRes.mediana)}</td></tr>
                {/* calidadRes.comentariosAdminPorEntregable (src/lib/desempeno.ts) suma
                   admin Y operador — "equipo", no solo admin (tarea I4, punto 3):
                   se renombra la etiqueta en vez de cambiar qué cuenta la función,
                   que sigue siendo el dato útil (comentarios internos vs. del cliente). */}
                <tr><td>Comentarios del equipo por entregable</td><td colspan="2">{calidadRes.comentariosAdminPorEntregable.toFixed(1)}</td></tr>
                <tr><td>Comentarios de cliente por entregable</td><td colspan="2">{calidadRes.comentariosClientePorEntregable.toFixed(1)}</td></tr>
              </tbody>
            </table>
          </div>
        </section>
      </section>

      {esAdmin && (
        <section class="seccion">
          <h2>Por operador</h2>
          <section class="tarjeta">
            <div class="tabla-envoltura">
              <table>
                <thead>
                  <tr><th>Operador</th><th>Clientes</th><th>Etapas activas</th><th>Avance</th><th>Días a aprobar</th><th>Rondas</th><th>Costo</th></tr>
                </thead>
                <tbody>
                  {filasPorOperador.map((f) => (
                    <tr>
                      <td>{f.nombre}</td>
                      <td>{f.clientes}</td>
                      <td>{f.etapasActivas}</td>
                      <td>{pct(f.avancePromedio)}</td>
                      <td>{dias(f.dias)}</td>
                      <td>{f.rondas === null ? '—' : f.rondas.toFixed(1)}</td>
                      <td>{dinero(f.costo)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </section>

        <section class="seccion">
          <h2>Operador × etapa</h2>
          <p class="secundario" style="margin-bottom:10px">Días hasta aprobar (mediana), rondas de cambios (promedio) y costo del periodo, por etapa.</p>
          <section class="tarjeta">
            <div class="tabla-envoltura">
              <table>
                <thead>
                  <tr>
                    <th>Operador</th>
                    {ETAPAS.map((et) => <th>{NOMBRE_ETAPA[et]}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {filasDesgloseOperador.map((f) => (
                    <tr>
                      <td>{f.nombre}</td>
                      {ETAPAS.map((et) => (
                        <td class="celda-etapa">
                          <span>{dias(f.porEtapa[et].dias)}</span>
                          <span>{textoRondas(f.porEtapa[et].rondas)}</span>
                          <span>{dinero(f.porEtapa[et].costo)}</span>
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </section>
      )}

      <section class="seccion">
        <h2>Por cliente</h2>
        <section class="tarjeta">
          <div class="tabla-envoltura">
            <table>
              <thead>
                <tr><th>Cliente</th><th>Avance</th><th>Etapa actual</th><th>Operador</th><th>Costo</th></tr>
              </thead>
              <tbody>
                {filasPorCliente.map((f) => (
                  <tr>
                    <td>{f.nombre}</td>
                    <td>{pct(f.avance)}</td>
                    <td>{f.etapaActual}</td>
                    <td>{f.operador}</td>
                    <td>{dinero(f.costo)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </section>

      <section class="seccion">
        <h2>Cliente × etapa</h2>
        <p class="secundario" style="margin-bottom:10px">Días hasta aprobar (mediana), rondas de cambios (promedio) y costo del periodo, por etapa.</p>
        <section class="tarjeta">
          <div class="tabla-envoltura">
            <table>
              <thead>
                <tr>
                  <th>Cliente</th>
                  {ETAPAS.map((et) => <th>{NOMBRE_ETAPA[et]}</th>)}
                </tr>
              </thead>
              <tbody>
                {filasDesgloseCliente.map((f) => (
                  <tr>
                    <td>{f.nombre}</td>
                    {ETAPAS.map((et) => (
                      <td class="celda-etapa">
                        <span>{dias(f.porEtapa[et].dias)}</span>
                        <span>{textoRondas(f.porEtapa[et].rondas)}</span>
                        <span>{dinero(f.porEtapa[et].costo)}</span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </section>
    </>
  )}
</Base>

<script>
  // Mismo patrón que src/pages/clientes/index.astro: el <select> manda el
  // formulario solo con JS; sin JS queda el botón «Aplicar» del formulario.
  const operadorFiltro = document.getElementById('operador-filtro') as HTMLSelectElement | null;
  operadorFiltro?.addEventListener('change', () => operadorFiltro.form?.submit());
</script>

<style>
  /* Estado activo de los chips de periodo (son enlaces, no botones: cada
     clic recarga con el periodo nuevo, así que no hay aria-pressed que
     alternar por JS). */
  .chip.activo { background: var(--tinta); border-color: var(--tinta); color: var(--fondo); }
  .chip { text-decoration: none; display: inline-flex; align-items: center; }

  /* graficaBarras (src/render/investigacion/graficas.ts) inyecta HTML crudo
     por set:html, así que sus clases no reciben el hash de scoping de Astro:
     se declaran con :global(). Mismos tokens que usa esa gráfica en los
     documentos rendidos (src/render/investigacion/estilos.ts). */
  .rejilla { grid-template-columns: 1fr; }
  @media (min-width: 900px) { .rejilla { grid-template-columns: repeat(2, 1fr); } }
  :global(.grafica) { background: var(--tarjeta); border: 1px solid var(--linea); border-radius: var(--r); padding: 24px; display: grid; gap: 12px; box-shadow: var(--sombra); }
  :global(.grafica figcaption) { font: var(--t-micro); letter-spacing: 0.1em; text-transform: uppercase; color: var(--suave); }
  :global(.barra-fila) { display: grid; grid-template-columns: minmax(0, 160px) minmax(0, 1fr) auto; gap: 14px; align-items: center; font: var(--t-small); }
  :global(.barra-nombre) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.barra-pista) { position: relative; height: 14px; border-radius: var(--r-pill); background: var(--gris); }
  :global(.barra-relleno) { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: var(--azul); }
  :global(.barra-valor) { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--tinta); }
  @media (max-width: 699px) { :global(.barra-fila) { grid-template-columns: 1fr auto; } :global(.barra-pista) { grid-column: 1 / -1; grid-row: 2; } }

  /* Celda de las matrices «cliente × etapa» / «operador × etapa»: días,
     rondas y costo apilados en una sola celda por etapa, en vez de un
     encabezado con colspan de 3 columnas por etapa — con 4 etapas eso serían
     12 columnas de datos más la de nombre, mucho menos legible en celular
     aun con el desplazamiento horizontal de `.tabla-envoltura`. */
  .celda-etapa { display: flex; flex-direction: column; gap: 2px; white-space: nowrap; font: var(--t-micro); }
  .celda-etapa span:first-child { font: var(--t-small); font-weight: 600; color: var(--tinta); }
</style>
