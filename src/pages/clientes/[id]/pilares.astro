---
import { eq } from 'drizzle-orm';
import Base from '@/layouts/Base.astro';
import Icono from '@/components/Icono.astro';
import { db, clients, clientLinks, clientFiles, researchResults } from '@/db';
import { puedeGenerarPilares, contarEtapasConDatos } from '@/lib/precheck';

const { id } = Astro.params;

const [cliente] = await db.select().from(clients).where(eq(clients.id, id!)).limit(1);
if (!cliente) return new Response('Cliente no encontrado', { status: 404 });

const enlaces = await db.select().from(clientLinks).where(eq(clientLinks.clientId, cliente.id));
const archivos = await db.select().from(clientFiles).where(eq(clientFiles.clientId, cliente.id));
const conTexto = archivos.filter((a) => a.estadoExtraccion === 'ok');
const investigaciones = await db.select({ datos: researchResults.datos }).from(researchResults).where(eq(researchResults.clientId, cliente.id));

// La mejor investigación manda: si alguna versión tiene datos, el mapa parte
// de ella aunque la más reciente haya fallado.
const etapasConDatos = Math.max(0, ...investigaciones.map((r) => contarEtapasConDatos(r.datos)));
const puede = puedeGenerarPilares({ etapasConDatos });

const renglones = [
  {
    nombre: 'Investigación',
    valor: etapasConDatos > 0 ? `${etapasConDatos} etapa${etapasConDatos === 1 ? '' : 's'} con datos` : 'Sin datos',
    aviso: puede.ok ? undefined : puede.razon,
  },
  { nombre: 'Giro y producto', valor: `${cliente.giro} · ${cliente.producto}`, aviso: undefined },
  { nombre: 'Ciudad', valor: cliente.ciudad ?? 'Sin ciudad', aviso: cliente.ciudad ? undefined : 'Falta la ciudad. El mapa no podrá enfocar temas locales.' },
  { nombre: 'Enlaces', valor: `${enlaces.length}`, aviso: enlaces.length ? undefined : 'No hay enlaces registrados. El mapa no podrá revisar los activos del cliente.' },
  { nombre: 'Archivos con texto', valor: `${conTexto.length} de ${archivos.length}`, aviso: conTexto.length ? undefined : 'No hay archivos con texto extraído. Se perderá el detalle del producto.' },
];

const estimado = Number(process.env.COST_ESTIMATE_PILARES_USD || 3);
const tope = Number(process.env.COST_LIMIT_USD || 15);
const dinero = (n: number) => n.toLocaleString('es-MX', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
---

<Base titulo={`Mapa de pilares · ${cliente.nombre}`} activo="clientes" volver={{ href: `/clientes/${cliente.id}`, texto: cliente.nombre }}>
  <div class="encabezado">
    <div>
      <p class="eyebrow">Mapa de pilares</p>
      <h1>Generar el mapa de pilares de {cliente.nombre}</h1>
      <p class="sub">Estrategia, cinco pilares en paralelo y revisión automática de duplicados y mix.</p>
    </div>
  </div>

  <div class="investigar">
    <section class="tarjeta">
      <h2>Lo que se va a enviar</h2>
      <p class="sub">Nada de lo que falta bloquea el mapa, salvo la investigación: sin datos de origen no hay nada sobre lo que razonar.</p>
      <ul class="lista">
        {renglones.map((r) => (
          <li class="renglon">
            <span class="icono-tinte" style={r.aviso ? 'color:var(--amarillo)' : 'color:var(--verde)'}>
              <Icono nombre={r.aviso ? 'alerta' : 'check'} />
            </span>
            <div class="cuerpo">
              <strong>{r.nombre}</strong>
              <p class="secundario">{r.valor}</p>
              {r.aviso && <p class="ayuda" style="color:var(--amarillo)">{r.aviso}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <aside class="tarjeta costo">
      <p class="eyebrow">Costo estimado</p>
      <p class="display cifra">{dinero(estimado)}</p>
      <p class="secundario">Tope duro: <span class="cifra">{dinero(tope)}</span></p>
      <p class="aviso" style="margin-top:16px">Al alcanzar el tope, los pilares que falten quedan sin generar en vez de continuar.</p>
      <div class="aviso rosa" id="error" role="alert" style="margin-top:12px" hidden></div>
      <div class="acciones">
        <button type="button" class="btn ancho-total" id="lanzar" disabled={!puede.ok}>Generar mapa de pilares</button>
        <a href={`/clientes/${cliente.id}`} class="btn fantasma ancho-total">Cancelar</a>
      </div>
    </aside>
  </div>
</Base>

<style>
  /* Este grid no es .rejilla, así que .tarjeta + .tarjeta de global.css sigue
     aplicando aquí; se anula aparte. El tamaño del icono del checklist vive
     en global.css (.renglon .icono-tinte svg) porque un <style> con scope no
     puede alcanzar el <svg> que pinta Icono.astro. */
  .investigar { display: grid; gap: 18px; }
  .investigar .tarjeta + .tarjeta { margin-top: 0; }
  @media (min-width: 900px) {
    .investigar { grid-template-columns: 1fr 340px; align-items: start; }
    .costo { position: sticky; top: 90px; }
  }
</style>

<script>
  const lanzar = document.getElementById('lanzar') as HTMLButtonElement;
  const error = document.getElementById('error') as HTMLElement;
  const clientId = window.location.pathname.split('/')[2];

  lanzar.addEventListener('click', async () => {
    error.hidden = true;
    lanzar.disabled = true;
    const original = lanzar.textContent;
    lanzar.textContent = 'Encolando…';

    try {
      const res = await fetch('/api/jobs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientId, tipo: 'pilares' }),
      });
      const cuerpo = await res.json();

      if (cuerpo.ok) {
        window.location.href = `/jobs/${cuerpo.id}`;
        return;
      }

      if (res.status === 409 && cuerpo.jobId) {
        window.location.href = `/jobs/${cuerpo.jobId}`;
        return;
      }

      error.textContent = (cuerpo.errores ?? ['No se pudo lanzar el mapa de pilares.']).join(' · ');
      error.hidden = false;
    } catch {
      error.textContent = 'No se pudo contactar al servidor.';
      error.hidden = false;
    }

    lanzar.disabled = false;
    lanzar.textContent = original;
  });
</script>
