---
// La pantalla donde el operador arma el lote del mes (diseño §2–§5, tarea B3).
//
// Una URL por cliente y mes (`/clientes/[id]/contenido/2026-09`), que es la
// misma forma que tiene el periodo en la base: el mes es el eje de esta etapa,
// no un filtro dentro de la ficha (diseño §2). Los meses anteriores siguen
// aquí, cada uno en su dirección.
//
// La página lee y entrega; quien escribe es la API de la tarea B1, a través de
// la isla `PiezasEditor`. No se inventa ninguna regla nueva: el cuadre con el
// paquete es `cuadraConPaquete`, los días de revisión salen del cliente con el
// `DIAS_REVISION_POR_OMISION` de las reglas, y el color del estado del lote es
// el `COLOR_ESTADO` de la ficha, que puede usarse tal cual porque
// `contenido_lotes.estado` reusa el enum de las etapas.
import { and, asc, desc, eq } from 'drizzle-orm';
import Base from '@/layouts/Base.astro';
import Icono from '@/components/Icono.astro';
import PiezasEditor, { type ArchivoCliente, type GrupoTemas, type PiezaUI } from '@/components/PiezasEditor';
import { db, clientFiles, contenidoLotes, contenidoPiezas, pilaresResults } from '@/db';
import { DIAS_REVISION_POR_OMISION, periodoValido, type Paquete } from '@/contenido/reglas';
import { asegurarLotesAlDia } from '@/contenido/auto-aprobacion';
import { enlacesDelLote } from '@/contenido/enlaces';
import { ETIQUETA_ESTADO_ETAPA, NOMBRE_ETAPA } from '@/flujo/reglas';
import { COLOR_ESTADO } from '@/flujo/ui';
import { etapasDelCliente } from '@/flujo/servicio';
import { baseUrlPublica } from '@/lib/base-url';
import { puedeOperarCliente } from '@/lib/permisos';
import { slugificar } from '@/lib/slug';
import { clienteVisible } from '@/lib/visibilidad';
import { fechaHora } from '@/lib/ui/fecha';
import { nombrePeriodo, periodoVecino } from '@/lib/ui/periodo';
import type { MapaPilares } from '@/pilares/schemas';

const usuario = Astro.locals.usuario;
const { id, periodo } = Astro.params;

const cliente = await clienteVisible(usuario, id!);
if (!cliente) return new Response(null, { status: 404 });
// Un periodo que no es `AAAA-MM` no puede existir en la base (la tabla lo
// comprueba con un CHECK), así que la página no existe: 404 en vez de una
// pantalla vacía que invite a abrir un lote imposible.
if (!periodoValido(periodo)) return new Response(null, { status: 404 });
const mes = periodo!;
const operable = puedeOperarCliente(usuario, cliente);

// La pantalla del mes es donde más caro sale ver un estado viejo: aquí se
// decide si el lote sigue esperando al cliente. Se resuelve el vencimiento
// antes de leerlo (C3, diseño §6); sin nada vencido es una consulta sin filas
// y ninguna escritura.
await asegurarLotesAlDia(cliente.id);

const [lote] = await db.select().from(contenidoLotes)
  .where(and(eq(contenidoLotes.clientId, cliente.id), eq(contenidoLotes.periodo, mes)))
  .limit(1);

const filas = lote
  ? await db.select().from(contenidoPiezas).where(eq(contenidoPiezas.loteId, lote.id)).orderBy(asc(contenidoPiezas.numero))
  : [];

// Campo por campo, como `piezaVisibleJson`: así una columna nueva de
// `contenido_piezas` no viaja sola al navegador. Las fechas de auditoría se
// quedan aquí —esta pantalla ordena por número— y con ellas el problema de
// serializar `Date` hacia la isla.
const piezas: PiezaUI[] = filas.map((p) => ({
  id: p.id,
  numero: p.numero,
  formato: p.formato,
  plataforma: p.plataforma,
  fechaPublicacion: p.fechaPublicacion,
  temaId: p.temaId,
  copy: p.copy,
  cta: p.cta,
  hashtags: p.hashtags,
  briefVisual: p.briefVisual,
  arte: Array.isArray(p.arte) ? p.arte : [],
  estadoCliente: p.estadoCliente,
  notaCliente: p.notaCliente,
}));

// Los otros meses de este cliente, para poder saltar entre ellos sin escribir
// la URL a mano.
const meses = await db
  .select({ periodo: contenidoLotes.periodo, estado: contenidoLotes.estado })
  .from(contenidoLotes)
  .where(eq(contenidoLotes.clientId, cliente.id))
  .orderBy(desc(contenidoLotes.periodo));

const etapas = await etapasDelCliente(cliente.id);
const etapaMensual = etapas.find((e) => e.etapa === 'desarrollo_mensual');
// Mismo criterio que `POST /api/contenido/lotes`, para que la pantalla no
// ofrezca abrir un lote que el servidor va a rechazar con un 409.
const contratada = !!etapaMensual && (etapaMensual.contratada || etapaMensual.interna);

// El mapa de pilares MÁS RECIENTE: es de donde se eligen los temas de las
// piezas nuevas. Las versiones anteriores no se ofrecen, pero una pieza
// planeada con una de ellas conserva su tema (la isla le hace su propia opción
// en el `<select>`, y `POST …/propuestas` busca el tema en todas las versiones).
const [mapa] = await db.select({ datos: pilaresResults.datos })
  .from(pilaresResults)
  .where(eq(pilaresResults.clientId, cliente.id))
  .orderBy(desc(pilaresResults.version))
  .limit(1);

// `datos` es `jsonb`: un mapa donde los cinco pilares fallaron no tiene nada
// que recorrer, y eso no debe tumbar la página.
const datosMapa = (mapa?.datos ?? null) as MapaPilares | null;
const nombresPilares = Array.isArray(datosMapa?.estrategia?.pilares) ? datosMapa!.estrategia.pilares.map((p) => p.nombre) : [];
const grupos: GrupoTemas[] = (Array.isArray(datosMapa?.pilares) ? datosMapa!.pilares : []).flatMap((p) =>
  p.estado === 'ok'
    ? p.subcategorias.map((s) => ({
        etiqueta: `${nombresPilares[p.numero - 1] ?? `Pilar ${p.numero}`} · ${s.nombre}`,
        temas: s.temas.map((t) => ({ id: t.id, texto: t.texto })),
      }))
    : [],
);

// Los archivos del cliente sirven para ponerle nombre a un arte subido, que en
// la pieza se guarda solo como `fileId`.
const archivos: ArchivoCliente[] = await db
  .select({ id: clientFiles.id, nombreOriginal: clientFiles.nombreOriginal })
  .from(clientFiles)
  .where(eq(clientFiles.clientId, cliente.id));

// **Un mes que volvió al operador.** `refrescarLote` (src/contenido/servicio.ts)
// devuelve a `en_proceso` un lote cuya ronda ya terminó, y le limpia
// `compartido_en` y `limite_revision`, en cuanto sus piezas cambian: un plazo
// solo corre sobre material que se le compartió al cliente, y la pieza que se
// acaba de agregar no lo es. La firma de ese estado es un lote sin
// `compartido_en` cuyas piezas, sin embargo, ya traen la respuesta del cliente
// —uno que nunca se compartió las tiene todas `pendiente`—.
//
// La pantalla lo dice porque si no, el cambio es mudo: el operador dejó un mes
// aprobado, agrega una pieza y se encuentra la etiqueta en «En proceso» sin
// nada que lo explique. Y lo que hay que explicar no es solo el estado: es que
// el plazo anterior se detuvo y que hace falta volver a compartir para que el
// cliente vea lo nuevo.
const reabierto = !!lote && lote.compartidoEn === null && filas.some((p) => p.estadoCliente !== 'pendiente');

// **Un mes al que se le apagó el plazo.** `registrarRevision`
// (src/contenido/revision.ts) deja el lote `en_revision` con `limite_revision`
// nulo cuando el plazo de la ronda se consumió mientras el mes esperaba al
// operador y el cliente se retractó de la pieza que había devuelto. La firma es
// un lote compartido y sin fecha límite, que no la tiene ningún otro estado: el
// mes que vuelve al operador pierde también `compartido_en`.
//
// Se dice por lo mismo que el `reabierto`: si no, el operador ve desaparecer la
// fecha límite del encabezado sin explicación y no tiene por qué adivinar que
// el mes dejó de auto-aprobarse ni que el botón de compartir vuelve a arrancar
// un plazo, cuando en cualquier otro mes ya compartido solo crea otro enlace.
const sinPlazo = !!lote && lote.compartidoEn !== null && lote.limiteRevision === null;

// De los dos meses sin fecha, este es el que además quedó **aprobado**: no
// quedaba ninguna pieza pendiente cuando el cliente se retractó, así que el
// recálculo dedujo `aprobada` y el plazo se apagó igual. Se distingue porque lo
// que hay que decirle al operador es distinto: aquí el cliente no está
// revisando nada —ya aprobó el mes entero—, pero sigue pudiendo cambiar de
// opinión mientras el mes no tenga fecha, y compartirlo otra vez es lo que lo
// cierra (ver `aceptaDecision` y `compartirLote`).
const aprobadoSinPlazo = sinPlazo && lote?.estado === 'aprobada';

// **Los enlaces del mes.** Cada «Compartir el mes» crea otro token, y hasta
// ahora ninguno se podía cerrar desde ninguna pantalla: un enlace que salió por
// WhatsApp al contacto equivocado se quedaba abierto para siempre. Se listan
// aquí, y no en un panel flotante como en los otros tres entregables, por lo
// mismo que el botón de compartir: en esta etapa el enlace no solo publica,
// también sostiene el plazo de revisión — retirar el último lo detiene (ver
// `retirarEnlaceDelLote`, src/contenido/enlaces.ts).
const enlaces = lote ? await enlacesDelLote(lote.id) : [];
const enlacesActivos = enlaces.filter((e) => !e.revocado);
// Un mes sin `compartido_en` al que le quedan enlaces retirados no es lo mismo
// que uno que nunca se compartió, aunque la fila del lote los describa igual.
const retirado = !!lote && lote.compartidoEn === null && enlacesActivos.length === 0 && enlaces.length > 0;
const base = baseUrlPublica(Astro.request);
const clienteSlug = slugificar(cliente.nombre);
const urlEnlace = (token: string) => `${base}/p/${clienteSlug}/${token}`;

const paquete = (cliente.paquete ?? {}) as Paquete;
// El plazo en palabras («2 días hábiles»), en un solo lugar: la pantalla lo
// repite en el encabezado y en los tres textos del bloque de compartir.
const diasRevision = cliente.diasRevision ?? DIAS_REVISION_POR_OMISION;
const plazo = `${diasRevision} ${diasRevision === 1 ? 'día hábil' : 'días hábiles'}`;
const titulo = nombrePeriodo(mes);
const anterior = periodoVecino(mes, -1);
const siguiente = periodoVecino(mes, 1);
const ruta = (p: string) => `/clientes/${cliente.id}/contenido/${p}`;
---

<Base titulo={`${titulo} · ${cliente.nombre}`} activo="clientes" volver={{ href: `/clientes/${cliente.id}`, texto: cliente.nombre }}>
  <div class="encabezado">
    <div>
      <p class="eyebrow">{NOMBRE_ETAPA.desarrollo_mensual}</p>
      <h1>Contenido de {titulo}</h1>
      <p class="sub">
        {cliente.nombre} · {plazo} de revisión
        {lote && <> · <span class={`etiqueta ${COLOR_ESTADO[lote.estado]}`}>{ETIQUETA_ESTADO_ETAPA[lote.estado]}</span></>}
      </p>
    </div>
  </div>

  <nav class="mes-nav" aria-label="Otros meses">
    <a class="btn fantasma chico" href={ruta(anterior)}><Icono nombre="atras" />{nombrePeriodo(anterior)}</a>
    <a class="btn fantasma chico" href={ruta(siguiente)}>{nombrePeriodo(siguiente)}</a>
    {meses.filter((m) => m.periodo !== mes).map((m) => (
      <a class="btn fantasma chico" href={ruta(m.periodo)}>{nombrePeriodo(m.periodo)}</a>
    ))}
  </nav>

  {!contratada && (
    <p class="aviso amarillo" style="margin-bottom:18px">
      {NOMBRE_ETAPA.desarrollo_mensual} no está contratada para {cliente.nombre}. El mes se puede consultar, pero no abrir.
    </p>
  )}

  {sinPlazo && (aprobadoSinPlazo ? (
    <p class="aviso amarillo" style="margin-bottom:18px">
      <strong>Este mes está aprobado, pero sin fecha límite.</strong> El plazo de la ronda anterior se consumió
      mientras el mes estaba de tu lado, y después el cliente retiró los cambios que había pedido y aprobó esa
      pieza él mismo: con eso quedó aprobado el mes entero. Ese reloj se paró a su favor, así que mientras no
      haya fecha sigue pudiendo cambiar de opinión sobre cualquier pieza. Para cerrarlo, comparte el mes otra
      vez: eso le pone un plazo nuevo de {plazo} y, cuando pase, el mes deja de admitir cambios.
    </p>
  ) : (
    <p class="aviso amarillo" style="margin-bottom:18px">
      <strong>Este mes se quedó sin fecha límite.</strong> El plazo de la ronda anterior se consumió mientras
      el mes estaba de tu lado, y después el cliente retiró los cambios que había pedido y aprobó esa pieza
      él mismo. Hacer valer ahí un plazo vencido habría dado por aprobadas, en el acto, las piezas que todavía
      no ha mirado, así que se detuvo: el cliente sigue revisando en su portal, pero el mes ya no se va a
      aprobar solo. Para que vuelva a tener fecha, comparte el mes otra vez: eso arranca un plazo nuevo de {plazo}.
    </p>
  ))}

  {reabierto && (
    <p class="aviso amarillo" style="margin-bottom:18px">
      <strong>Este mes volvió a estar en proceso.</strong> Sus piezas cambiaron después de que el cliente
      lo revisó, así que el plazo anterior se detuvo: lo que ya había aprobado sigue aprobado, pero el
      contenido nuevo todavía no lo ha visto y el mes dejó de estar a la vista en su portal.
      Cuando esté listo, vuelve a compartirlo: eso le da acceso otra vez y arranca un plazo nuevo de {plazo}.
    </p>
  )}

  {lote ? (
    <>
      <section class="compartir-mes" data-lote={lote.id}>
        <div class="compartir-texto">
          <strong>Compartir con el cliente</strong>
          {aprobadoSinPlazo && lote.compartidoEn ? (
            <p class="secundario">
              Compartido el {fechaHora(lote.compartidoEn)} · aprobado, pero sin fecha límite.
              Volver a compartirlo le pone un plazo nuevo de {plazo} y, al vencer, cierra el mes; hasta
              entonces el cliente todavía puede retirar alguna de sus aprobaciones.
            </p>
          ) : sinPlazo && lote.compartidoEn ? (
            <p class="secundario">
              Compartido el {fechaHora(lote.compartidoEn)} · este mes ya no tiene fecha límite.
              Volver a compartirlo arranca un plazo nuevo de {plazo} sobre lo que el cliente aún no ha
              aprobado; mientras tanto, el mes sigue en su portal y no se aprueba solo.
            </p>
          ) : lote.compartidoEn ? (
            <p class="secundario">
              Compartido el {fechaHora(lote.compartidoEn)}
              {/* `fechaHora` ya termina en punto («11:59 p.m.»), así que la frase no le añade otro. */}
              {lote.limiteRevision && <> · el plazo vence el {fechaHora(lote.limiteRevision)}</>}
              {lote.estado === 'con_cambios'
                ? ' Al volver a compartirlo, el plazo empieza de nuevo: es una ronda nueva de revisión.'
                : ' Volver a compartirlo crea otro enlace, pero no mueve la fecha límite.'}
            </p>
          ) : reabierto ? (
            <p class="secundario">
              El plazo de la ronda anterior se detuvo al cambiar las piezas. Volver a compartir el mes es lo
              que arranca uno nuevo de {plazo}: el lote pasa a revisión y, si el cliente no contesta antes de
              la fecha límite, se da por aprobado.
            </p>
          ) : retirado ? (
            <p class="secundario">
              Se retiraron todos los enlaces de este mes, así que el plazo se detuvo: el cliente ya no puede
              abrirlo, ni por el enlace ni desde su portal. Un enlace nuevo le devuelve el acceso y arranca un
              plazo nuevo de {plazo}.
            </p>
          ) : (
            <p class="secundario">
              Crea el enlace del mes y arranca el plazo de {plazo}:
              el lote pasa a revisión y, si el cliente no contesta antes de la fecha límite, se da por aprobado.
            </p>
          )}
        </div>
        <button type="button" class="btn" id="compartir-lote" disabled={!operable}>
          {sinPlazo || reabierto || retirado ? 'Volver a compartir el mes' : lote.compartidoEn ? 'Crear otro enlace' : 'Compartir el mes'}
        </button>
      </section>

      {/* Los enlaces que andan sueltos por ahí. La sección solo aparece cuando
          este mes ha tenido alguno: un lote recién abierto no necesita una
          lista vacía debajo del botón que la va a llenar. */}
      {enlaces.length > 0 && (
        <section class="enlaces-mes">
          <div class="enlaces-texto">
            <strong>Enlaces de este mes</strong>
            <p class="secundario">
              Cada vez que se comparte el mes se crea un enlace nuevo, y todos siguen abiertos hasta que se
              retiran. Retirar uno lo deja en 404 para siempre; retirar el último le quita el acceso al cliente
              {lote.estado === 'en_revision' ? <> y detiene el plazo de revisión</> : null}.
            </p>
          </div>

          {enlacesActivos.length === 0 ? (
            <p class="secundario">
              No queda ningún enlace activo: los {enlaces.length} que se crearon están retirados.
            </p>
          ) : (
            <ul class="enlaces-lista">
              {enlacesActivos.map((e) => (
                <li data-token={e.token}>
                  <input
                    type="text"
                    class="enlace-url"
                    readonly
                    value={urlEnlace(e.token)}
                    aria-label={`Enlace creado el ${fechaHora(e.creadoEn)}`}
                  />
                  <p class="secundario">
                    Creado el {fechaHora(e.creadoEn)} · {e.visitas} {e.visitas === 1 ? 'visita' : 'visitas'}
                  </p>
                  <div class="enlaces-acciones">
                    <button type="button" class="btn suave chico" data-copiar>Copiar</button>
                    <button type="button" class="btn peligro chico" data-retirar disabled={!operable}>Retirar</button>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      )}
      <PiezasEditor
        client:load
        clientId={cliente.id}
        loteId={lote.id}
        paquete={paquete}
        grupos={grupos}
        operable={operable}
        estadoLote={lote.estado}
        piezas={piezas}
        archivos={archivos}
      />
    </>
  ) : (
    <section class="tarjeta">
      <div class="vacio">
        <Icono nombre="vacio" />
        <strong>{titulo} todavía no tiene lote</strong>
        Abrirlo hereda el paquete del cliente y deja la etapa en proceso. Los meses anteriores no se tocan.
        <button type="button" class="btn" id="abrir-lote" data-client-id={cliente.id} data-periodo={mes} disabled={!operable || !contratada}>
          Abrir el lote de {titulo}
        </button>
      </div>
      <p class="aviso rosa" id="error-lote" role="alert" hidden></p>
    </section>
  )}
</Base>

<style is:global>
  /* Global y no con scope a propósito: casi todo lo de aquí abajo lo pinta la
     isla de React (`PiezasEditor`), y el `data-astro-cid` que Astro le pone a
     un <style> con scope solo alcanza al marcado de este archivo. El CSS
     igual viaja solo en esta página, que es la única que lo carga. */

  .mes-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }

  /* Compartir el mes: es la acción que arranca el plazo de revisión, así que
     se explica al lado del botón y no se esconde en un panel flotante como en
     los otros entregables — aquí no solo publica, también mueve el estado. */
  .compartir-mes {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    padding: 16px; margin-bottom: 18px; border: 1px solid var(--linea);
    border-radius: var(--r); background: var(--tarjeta);
  }
  .compartir-texto { flex: 1; min-width: 240px; }
  .compartir-texto strong { display: block; color: var(--tinta); }
  .compartir-texto p { margin-top: 2px; max-width: 70ch; }

  /* Los enlaces vivos del mes, en su propia tarjeta debajo de la de compartir:
     son la consecuencia de ese botón y se leen en ese orden. Mismo marco que
     `.compartir-mes` para que las dos se vean como una sola conversación. */
  .enlaces-mes {
    padding: 16px; margin-bottom: 18px; border: 1px solid var(--linea);
    border-radius: var(--r); background: var(--tarjeta);
  }
  .enlaces-texto strong { display: block; color: var(--tinta); }
  .enlaces-texto p { margin-top: 2px; max-width: 70ch; }
  .enlaces-lista { list-style: none; margin-top: 14px; display: flex; flex-direction: column; gap: 12px; }
  .enlaces-lista li {
    display: grid; gap: 8px; padding: 12px; border: 1px solid var(--linea);
    border-radius: var(--r-sm); background: var(--fondo);
  }
  .enlaces-lista .enlace-url { min-height: 44px; padding: 6px 12px; font-size: 13px; }
  .enlaces-lista p { margin: 0; }
  .enlaces-acciones { display: flex; flex-wrap: wrap; gap: 8px; }

  /* A partir de tablet la fila se lee de un vistazo: el enlace ocupa el ancho
     que sobra y los botones se quedan a la derecha. En celular cada cosa
     ocupa su renglón, que es lo que hace la cuadrícula por omisión. */
  @media (min-width: 700px) {
    .enlaces-lista li { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    .enlaces-lista li p { grid-column: 1; }
    .enlaces-acciones { grid-column: 2; grid-row: 1 / span 2; }
  }

  /* El indicador de global.css es de dos renglones (valor y nombre); aquí lleva
     un tercero con lo que pide el paquete, y sin esto se pegaría al nombre. */
  .indicador .nombre, .indicador .secundario { display: block; }

  .piezas { display: flex; flex-direction: column; gap: 12px; }

  .pieza { border: 1px solid var(--linea); border-radius: var(--r); background: var(--tarjeta); overflow: hidden; }

  /* La cabecera entera es el botón que abre la pieza: en celular, un área de
     toque del ancho de la tarjeta es la diferencia entre poder trabajar y no. */
  .pieza-cabeza {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 60px;
    padding: 12px 14px; border: 0; background: transparent; cursor: pointer; text-align: left; font: inherit;
  }
  .pieza-cabeza:hover { background: var(--gris); }
  .pieza-cabeza:focus-visible { outline: none; box-shadow: var(--foco); }
  .pieza-numero {
    flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center;
    background: var(--gris); color: var(--suave); font: var(--t-micro);
  }
  .pieza-resumen { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .pieza-resumen strong { color: var(--tinta); font: var(--t-h3); }
  .pieza-resumen .secundario { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .pieza-cuerpo { padding: 4px 14px 18px; border-top: 1px solid var(--linea); }
  .pieza-cuerpo .campos { margin-top: 16px; }
  .pieza-cuerpo .aviso { margin-top: 14px; }

  .pieza-artes { margin-top: 20px; }
  .pieza-artes h4, .propuestas h4 { font: var(--t-h3); color: var(--tinta); margin-bottom: 8px; }
  .pieza-artes .lista-archivos li { flex-wrap: wrap; }
  .pieza-artes .agregar { margin-top: 12px; }
  .pieza-artes input[type="file"] { padding: 9px 12px; }

  .propuestas { margin-top: 20px; border-top: 1px solid var(--linea); padding-top: 16px; }
  .propuesta { background: var(--gris); border-radius: var(--r-sm); padding: 14px; margin-top: 10px; }
  .propuesta strong { display: block; color: var(--tinta); margin-bottom: 8px; }
  /* El copy viene con sus saltos de línea: así se ve como se va a publicar. */
  .propuesta-copy { white-space: pre-wrap; margin-bottom: 8px; }
  .propuesta .btn { margin-top: 12px; }

  /* A partir de tablet los campos cortos comparten renglón; en celular cada
     uno ocupa el ancho completo (`.campos` de global.css ya es de 1 columna). */
  @media (min-width: 700px) {
    .pieza-cuerpo .campos { grid-template-columns: repeat(2, 1fr); }
  }

  /* En celular el resumen y el chip de revisión no caben en el mismo renglón:
     compartiéndolo, «post · Facebook e Instagram · 2026-09-18» se partía en
     cuatro líneas de dos palabras. El `min-width` obliga al chip a bajar a su
     propio renglón en vez de estrujar el texto. */
  @media (max-width: 599px) {
    .pieza-cabeza { flex-wrap: wrap; }
    .pieza-resumen { min-width: 190px; }
    .pieza-cabeza .etiqueta { margin-left: 42px; }
  }
</style>

<script>
  import { toast } from '@/scripts/toast';
  import { copiar } from '@/scripts/copiar';

  // Compartir el mes. Además de crear el enlace público, el servidor le estampa
  // al lote `compartido_en` y `limite_revision` y lo pone en revisión: es lo
  // que arranca el plazo (diseño §6). Qué pasa al compartir dos veces lo decide
  // `compartirLote` (src/contenido/servicio.ts), no esta pantalla.
  const compartir = document.getElementById('compartir-lote') as HTMLButtonElement | null;
  const seccionCompartir = compartir?.closest('.compartir-mes') as HTMLElement | null;

  compartir?.addEventListener('click', async () => {
    compartir.disabled = true;
    const original = compartir.textContent;
    compartir.textContent = 'Compartiendo…';
    try {
      const res = await fetch('/api/share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resultId: seccionCompartir?.dataset.lote, tipo: 'contenido' }),
      });
      const cuerpo = await res.json();
      if (!cuerpo.ok) throw new Error((cuerpo.errores ?? []).join(' · '));
      await copiar(cuerpo.url);
      // Siempre se recarga, y ahora sí sin perder nada: el enlace recién creado
      // aparece en la lista de «Enlaces de este mes», que la pinta el servidor.
      // Antes no se recargaba cuando el plazo no arrancaba, justamente porque
      // recargar borraba de la vista el único sitio donde se veía ese enlace.
      toast(cuerpo.arrancoElPlazo ? 'Mes compartido · el plazo empezó a correr' : 'Enlace creado');
      setTimeout(() => location.reload(), 1200);
    } catch (e) {
      toast(e instanceof Error && e.message ? e.message : 'No se pudo compartir el mes.', 'error');
    }
    compartir.disabled = false;
    compartir.textContent = original;
  });

  // Copiar y retirar cada enlace vivo. Delegado en la lista y no un listener
  // por fila: la lista se vuelve a pintar en el servidor después de cada
  // cambio, así que no hay nada que volver a enganchar.
  const lista = document.querySelector('.enlaces-lista');

  lista?.addEventListener('click', async (ev) => {
    const boton = (ev.target as HTMLElement | null)?.closest('button');
    if (!(boton instanceof HTMLButtonElement)) return;
    const fila = boton.closest('li') as HTMLLIElement | null;
    const token = fila?.dataset.token;
    const campo = fila?.querySelector('.enlace-url') as HTMLInputElement | null;
    if (!token || !campo) return;

    if (boton.hasAttribute('data-copiar')) {
      await copiar(campo.value, campo);
      return;
    }
    if (!boton.hasAttribute('data-retirar')) return;

    // Con confirmación, y diciendo qué se lleva por delante: retirar no se
    // deshace —el token queda en 404 para siempre— y, si es el último, el
    // cliente pierde el acceso al mes y el plazo se detiene. El servidor manda
    // igual: `activosRestantes` sale de la base, no de lo que se pintó aquí.
    const ultimo = lista.querySelectorAll('li').length === 1;
    const aviso = ultimo
      ? '¿Retirar este enlace? Es el último activo: el cliente dejará de poder abrir el mes y, si estaba en revisión, el plazo se detiene.'
      : '¿Retirar este enlace? Dejará de funcionar para siempre; los demás enlaces del mes siguen abiertos.';
    if (!window.confirm(aviso)) return;

    boton.disabled = true;
    try {
      const res = await fetch('/api/share', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const cuerpo = await res.json();
      if (!res.ok || !cuerpo.ok) throw new Error((cuerpo.errores ?? []).join(' · '));
      toast(cuerpo.detuvoElPlazo
        ? 'Enlace retirado · el plazo se detuvo y el mes volvió a estar en proceso'
        : 'Enlace retirado. Ahora devuelve 404.');
      setTimeout(() => location.reload(), 1200);
    } catch (e) {
      toast(e instanceof Error && e.message ? e.message : 'No se pudo retirar el enlace.', 'error');
      boton.disabled = false;
    }
  });

  // Abrir el lote del mes. Es lo único que esta página hace por su cuenta: en
  // cuanto el lote existe, manda la isla.
  const boton = document.getElementById('abrir-lote') as HTMLButtonElement | null;
  const error = document.getElementById('error-lote') as HTMLElement | null;

  boton?.addEventListener('click', async () => {
    if (!error) return;
    error.hidden = true;
    boton.disabled = true;
    const original = boton.textContent;
    boton.textContent = 'Abriendo…';

    try {
      const res = await fetch('/api/contenido/lotes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientId: boton.dataset.clientId, periodo: boton.dataset.periodo }),
      });
      const cuerpo = await res.json();
      if (cuerpo.ok) {
        toast('Lote abierto');
        location.reload();
        return;
      }
      error.textContent = (cuerpo.errores ?? ['No se pudo abrir el lote.']).join(' · ');
      error.hidden = false;
    } catch {
      error.textContent = 'No se pudo contactar al servidor.';
      error.hidden = false;
    }

    boton.disabled = false;
    boton.textContent = original;
  });
</script>
