---
import Base from '@/layouts/Base.astro';
import { NOMBRE_ETAPA } from '@/flujo/reglas';
---

<Base titulo="Nuevo cliente" activo="clientes" volver={{ href: '/clientes', texto: 'Clientes' }}>
  <div class="encabezado">
    <div>
      <p class="eyebrow">Alta</p>
      <h1>Nuevo cliente</h1>
      <p class="sub">Nombre, giro y producto son obligatorios. Lo demás mejora la investigación.</p>
    </div>
  </div>

  <form class="tarjeta" id="forma">
    <div class="campos">
      <div class="campo">
        <label for="nombre">Nombre <span class="req">*</span></label>
        <input id="nombre" name="nombre" required autofocus />
      </div>
      <div class="campo">
        <label for="giro">Giro <span class="req">*</span></label>
        <input id="giro" name="giro" required placeholder="Cosmetología, gimnasio, repostería…" />
      </div>
      <div class="campo ancho">
        <label for="producto">Producto o servicio <span class="req">*</span></label>
        <input id="producto" name="producto" required placeholder="Diplomado presencial de 6 meses" />
      </div>
      <div class="campo">
        <label for="ciudad">Ciudad</label>
        <input id="ciudad" name="ciudad" placeholder="Guadalajara" />
        <p class="ayuda">Sin ciudad, el foco geográfico será nacional.</p>
      </div>
      <div class="campo">
        <label for="ticket">Ticket</label>
        <input id="ticket" name="ticket" placeholder="$36,792" />
        <p class="ayuda">Determina si el ciclo de compra es largo.</p>
      </div>
      <div class="campo ancho">
        <label for="contacto">Contacto</label>
        <input id="contacto" name="contacto" placeholder="Nombre, teléfono o correo" />
      </div>
      <div class="campo ancho">
        <label for="notas">Notas del operador</label>
        <textarea id="notas" name="notas" placeholder="Lo que sepas y no esté en los documentos."></textarea>
      </div>
    </div>

    <fieldset class="campo ancho" style="margin-top:18px">
      <legend>Etapas contratadas</legend>
      <div class="contratacion-casillas">
        <label class="casilla"><input type="checkbox" name="etapas" value="investigacion" checked />{NOMBRE_ETAPA.investigacion}</label>
        <label class="casilla"><input type="checkbox" name="etapas" value="pilares" checked />{NOMBRE_ETAPA.pilares}</label>
        <label class="casilla"><input type="checkbox" name="etapas" value="manual_campana" checked />{NOMBRE_ETAPA.manual_campana}</label>
        <label class="casilla deshabilitada">
          <input type="checkbox" disabled />{NOMBRE_ETAPA.desarrollo_mensual}
          <span class="etiqueta marca">Próximamente</span>
        </label>
      </div>
      <p class="ayuda">Si contratas pilares o el manual sin investigación, esta se genera igual, pero como trabajo interno.</p>
    </fieldset>

    <div class="aviso rosa" id="errores" role="alert" style="margin-top:18px" hidden></div>

    <div class="acciones">
      <button type="submit" class="btn" id="guardar">Guardar cliente</button>
      <a href="/clientes" class="btn fantasma">Cancelar</a>
    </div>
  </form>
</Base>

<script>
  const forma = document.getElementById('forma') as HTMLFormElement;
  const errores = document.getElementById('errores') as HTMLElement;
  const guardar = document.getElementById('guardar') as HTMLButtonElement;

  forma.addEventListener('submit', async (e) => {
    e.preventDefault();
    errores.hidden = true;
    guardar.disabled = true;
    guardar.textContent = 'Guardando…';

    // Las casillas «etapas» comparten name: Object.fromEntries se quedaría
    // solo con la última marcada, así que se arma la lista aparte.
    const formData = new FormData(forma);
    const datos = { ...Object.fromEntries(formData.entries()), etapas: formData.getAll('etapas') };

    try {
      const res = await fetch('/api/clientes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(datos),
      });
      const cuerpo = await res.json();

      if (cuerpo.ok) {
        window.location.href = `/clientes/${cuerpo.id}`;
        return;
      }

      errores.textContent = (cuerpo.errores ?? ['No se pudo guardar el cliente.']).join(' · ');
      errores.hidden = false;
    } catch {
      errores.textContent = 'No se pudo contactar al servidor. Revisa tu conexión.';
      errores.hidden = false;
    }

    guardar.disabled = false;
    guardar.textContent = 'Guardar cliente';
  });
</script>
