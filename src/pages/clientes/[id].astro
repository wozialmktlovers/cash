---
import { eq, desc, and, ne } from 'drizzle-orm';
import Base from '@/layouts/Base.astro';
import Icono from '@/components/Icono.astro';
import LinksEditor from '@/components/LinksEditor';
import FilesUploader from '@/components/FilesUploader';
import { puedeGenerarPilares, contarEtapasConDatos } from '@/lib/precheck';
import { iniciales, tinte } from '@/lib/ui/cliente-visual';
import { ETIQUETA_ESTADO } from '@/lib/ui/progreso';
import { puedeOperarCliente } from '@/lib/permisos';
import { clienteVisible } from '@/lib/visibilidad';
import { db, clientLinks, clientFiles, researchJobs, researchResults, growthResults, pilaresResults, users } from '@/db';

const usuario = Astro.locals.usuario;
const { id } = Astro.params;

const cliente = await clienteVisible(usuario, id!);
if (!cliente) return new Response(null, { status: 404 });
const operable = puedeOperarCliente(usuario, cliente);
const esAdmin = usuario.rol === 'admin';

// ── Responsable ────────────────────────────────────
const [responsable] = cliente.operadorId
  ? await db.select({ id: users.id, nombre: users.nombre, email: users.email }).from(users).where(eq(users.id, cliente.operadorId)).limit(1)
  : [];
const operadoresActivos = esAdmin
  ? await db.select({ id: users.id, nombre: users.nombre, email: users.email }).from(users).where(and(ne(users.rol, 'cliente'), eq(users.activo, true))).orderBy(users.nombre)
  : [];
// El responsable guardado puede ya no estar entre los operadores activos (lo
// desactivaron, o nunca hubo uno asignado): el <select> no debe insinuar que
// hay alguien al mando cuando no es cierto.
const operadorAsignadoValido = !!cliente.operadorId && operadoresActivos.some((o) => o.id === cliente.operadorId);

// ── Usuarios del cliente ───────────────────────────
const usuariosCliente = operable
  ? await db.select({ id: users.id, nombre: users.nombre, email: users.email, activo: users.activo }).from(users).where(and(eq(users.rol, 'cliente'), eq(users.clientId, cliente.id))).orderBy(users.nombre)
  : [];

const enlaces = await db.select().from(clientLinks).where(eq(clientLinks.clientId, cliente.id));
const archivos = await db.select().from(clientFiles).where(eq(clientFiles.clientId, cliente.id));
const jobs = await db.select().from(researchJobs).where(eq(researchJobs.clientId, cliente.id)).orderBy(desc(researchJobs.createdAt));
const resultados = await db.select().from(researchResults).where(eq(researchResults.clientId, cliente.id));
const manuales = await db.select().from(growthResults).where(eq(growthResults.clientId, cliente.id)).orderBy(desc(growthResults.version));
const mapas = await db.select().from(pilaresResults).where(eq(pilaresResults.clientId, cliente.id)).orderBy(desc(pilaresResults.version));

const resultadoPorJob = new Map(resultados.map((r) => [r.jobId, r.id]));
const manualPorJob = new Map(manuales.map((m) => [m.jobId, m.id]));
const mapaPorJob = new Map(mapas.map((m) => [m.jobId, m.id]));

// El manual de campaña y el mapa de pilares parten de la investigación: sin
// una con datos no hay nada sobre lo que razonar, así que la tarjeta explica
// por qué no se puede.
const mejorEtapas = Math.max(0, ...resultados.map((r) => contarEtapasConDatos(r.datos)));
const puedeGrowth = mejorEtapas > 0;
const puedePilares = puedeGenerarPilares({ etapasConDatos: mejorEtapas });

const ultimaInvestigacion = jobs.find((j) => j.tipo === 'research');

const dinero = (n: number) => n.toLocaleString('es-MX', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
const fecha = (d: Date) => d.toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' });
const fechaHora = (d: Date) => d.toLocaleString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
---

<Base titulo={cliente.nombre} activo="clientes" volver={{ href: '/clientes', texto: 'Clientes' }}>
  <div class="ficha-cabeza">
    <span class={`avatar grande ${tinte(cliente.id)}`}>{iniciales(cliente.nombre)}</span>
    <div class="ficha-titulo">
      <h1>{cliente.nombre}</h1>
      <p class="sub">{cliente.giro}{cliente.ciudad ? ` · ${cliente.ciudad}` : ''}</p>
    </div>
    <div class="menu">
      <button type="button" class="icono-btn" id="menu-boton" aria-haspopup="true" aria-expanded="false" aria-controls="menu-lista" aria-label="Más acciones">
        <Icono nombre="puntos" />
      </button>
      <ul class="menu-lista" id="menu-lista" hidden>
        {operable && <li><button type="button" id="borrar">Eliminar cliente</button></li>}
      </ul>
    </div>
  </div>

  <div class="rejilla" style="margin-top:20px">
    <section class="tarjeta">
      <h2>Responsable</h2>
      {esAdmin ? (
        <div class="campo" style="margin-top:12px">
          <label for="responsable-select">Operador asignado</label>
          <select id="responsable-select">
            {!operadorAsignadoValido && (
              <option value="" disabled selected>
                {responsable ? `${responsable.nombre ?? responsable.email} (inactivo)` : 'Sin asignar'}
              </option>
            )}
            {operadoresActivos.map((o) => (
              <option value={o.id} selected={o.id === cliente.operadorId}>{o.nombre ?? o.email}</option>
            ))}
          </select>
        </div>
      ) : (
        <p class="secundario" style="margin-top:12px">{responsable ? (responsable.nombre ?? responsable.email) : 'Sin responsable asignado'}</p>
      )}
    </section>

    {operable && (
      <section class="tarjeta">
        <div class="tarjeta-cabeza-flex">
          <h2>Usuarios del cliente</h2>
          <button type="button" class="btn fantasma chico" id="abrir-invitar-usuario"><Icono nombre="mas" />Invitar usuario</button>
        </div>
        {usuariosCliente.length === 0 ? (
          <p class="secundario" style="margin-top:12px">Sin usuarios todavía.</p>
        ) : (
          <ul class="lista" style="margin-top:12px">
            {usuariosCliente.map((u) => (
              <li class="renglon">
                <div class="cuerpo">
                  <strong>{u.nombre ?? u.email}</strong>
                  <p class="secundario">{u.email}</p>
                </div>
                <span class={`etiqueta ${u.activo ? 'completado' : 'cancelado'}`}>{u.activo ? 'Activo' : 'Inactivo'}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}
  </div>

  <div class="rejilla tres" style="margin-top:24px">
    <section class="tarjeta accion">
      <span class="icono-tinte" style="background:var(--rosa-s);color:var(--rosa)"><Icono nombre="investigar" /></span>
      <h3>Investigar</h3>
      <p class="secundario">Social Research</p>
      <p class="secundario">
        {ultimaInvestigacion
          ? `Última: ${fecha(ultimaInvestigacion.createdAt)} · ${dinero(Number(ultimaInvestigacion.costoUsd))}`
          : 'Nunca investigado'}
      </p>
      {operable ? (
        <a href={`/clientes/${cliente.id}/investigar`} class="btn">Investigar</a>
      ) : (
        <span class="btn" aria-disabled="true">Investigar</span>
      )}
    </section>

    <section class="tarjeta accion">
      <span class="icono-tinte" style="background:var(--azul-s);color:var(--azul)"><Icono nombre="megafono" /></span>
      <h3>Manual de campaña</h3>
      <p class="secundario">Growth</p>
      {puedeGrowth ? (
        // El costo vive en el job, no en el manual, y el job puede haber fallado
        // después de generarlo; se muestra el último manual real (por versión).
        <p class="secundario">{manuales[0] ? `Último manual: ${fecha(manuales[0].createdAt)}` : 'Listo para generarse'}</p>
      ) : (
        <p class="secundario">Requiere una investigación con datos. El manual parte de ella.</p>
      )}
      <button type="button" class="btn" id="generar-growth" disabled={!puedeGrowth || !operable}>Generar</button>
    </section>

    <section class="tarjeta accion">
      <span class="icono-tinte" style="background:var(--verde-s);color:var(--verde)"><Icono nombre="entregables" /></span>
      <h3>Mapa de pilares</h3>
      <p class="secundario">Content Strategy</p>
      {puedePilares.ok ? (
        // Igual que el manual: el costo vive en el job, así que se muestra el
        // último mapa real (por versión), no el último intento.
        <p class="secundario">{mapas[0] ? `Último mapa: ${fecha(mapas[0].createdAt)}` : 'Listo para generarse'}</p>
      ) : (
        <p class="secundario">{puedePilares.razon}</p>
      )}
      {puedePilares.ok && operable ? (
        <a href={`/clientes/${cliente.id}/pilares`} class="btn">Generar</a>
      ) : (
        <span class="btn" aria-disabled="true">Generar</span>
      )}
    </section>
  </div>

  <div class="pestanas" role="tablist" aria-label="Secciones del cliente">
    <button type="button" role="tab" id="tab-datos" aria-controls="panel-datos" data-pestana="datos" aria-selected="true">Datos</button>
    <button type="button" role="tab" id="tab-enlaces" aria-controls="panel-enlaces" data-pestana="enlaces" aria-selected="false" tabindex="-1">Enlaces<span class="cuenta">{enlaces.length}</span></button>
    <button type="button" role="tab" id="tab-archivos" aria-controls="panel-archivos" data-pestana="archivos" aria-selected="false" tabindex="-1">Archivos<span class="cuenta">{archivos.length}</span></button>
    <button type="button" role="tab" id="tab-historial" aria-controls="panel-historial" data-pestana="historial" aria-selected="false" tabindex="-1">Historial<span class="cuenta">{jobs.length}</span></button>
  </div>

  <section class="tarjeta" role="tabpanel" id="panel-datos" aria-labelledby="tab-datos">
    <form id="forma">
      <div class="campos">
        <div class="campo"><label for="nombre">Nombre <span class="req">*</span></label><input id="nombre" name="nombre" value={cliente.nombre} required /></div>
        <div class="campo"><label for="giro">Giro <span class="req">*</span></label><input id="giro" name="giro" value={cliente.giro} required /></div>
        <div class="campo ancho"><label for="producto">Producto o servicio <span class="req">*</span></label><input id="producto" name="producto" value={cliente.producto} required /></div>
        <div class="campo"><label for="ciudad">Ciudad</label><input id="ciudad" name="ciudad" value={cliente.ciudad ?? ''} /></div>
        <div class="campo"><label for="ticket">Ticket</label><input id="ticket" name="ticket" value={cliente.ticket ?? ''} /></div>
        <div class="campo ancho"><label for="contacto">Contacto</label><input id="contacto" name="contacto" value={cliente.contacto ?? ''} /></div>
        <div class="campo ancho"><label for="notas">Notas del operador</label><textarea id="notas" name="notas">{cliente.notas ?? ''}</textarea></div>
      </div>
      {operable && <div class="acciones"><button type="submit" class="btn" id="guardar">Guardar cambios</button></div>}
    </form>
  </section>

  <section class="tarjeta" role="tabpanel" id="panel-enlaces" aria-labelledby="tab-enlaces" hidden>
    <p class="sub" style="margin:0 0 16px">Sitio, redes y páginas de venta. La investigación los revisa.</p>
    <LinksEditor client:load clientId={cliente.id} iniciales={enlaces} />
  </section>

  <section class="tarjeta" role="tabpanel" id="panel-archivos" aria-labelledby="tab-archivos" hidden>
    <p class="sub" style="margin:0 0 16px">PDF, DOCX, TXT e imágenes. Se extrae el texto para alimentar la investigación.</p>
    <FilesUploader client:load clientId={cliente.id}
      iniciales={archivos.map((a) => ({ id: a.id, nombreOriginal: a.nombreOriginal, mime: a.mime, bytes: a.bytes, estadoExtraccion: a.estadoExtraccion }))} />
  </section>

  <section class="tarjeta" role="tabpanel" id="panel-historial" aria-labelledby="tab-historial" hidden>
    {jobs.length === 0 ? (
      <div class="vacio">
        <Icono nombre="investigar" />
        <strong>Todavía no investigas a este cliente</strong>
        Revisa que los enlaces y archivos estén completos antes de lanzar.
      </div>
    ) : (
      <ul class="lista">
        {jobs.map((j) => (
          <li class="renglon">
            <div class="cuerpo">
              <strong>{j.tipo === 'growth' ? 'Manual de campaña' : j.tipo === 'pilares' ? 'Mapa de pilares' : 'Investigación'}</strong>
              <p class="secundario">{fechaHora(j.createdAt)} · <span class="cifra">{dinero(Number(j.costoUsd))}</span></p>
              {j.error && <p class="secundario" style="color:var(--rojo)">{j.error}</p>}
            </div>
            <span class={`etiqueta ${j.estado}`}>{ETIQUETA_ESTADO[j.estado] ?? j.estado}</span>
            {manualPorJob.has(j.id) ? (
              <a href={`/growth/${manualPorJob.get(j.id)}`} class="btn fantasma chico">Ver manual</a>
            ) : mapaPorJob.has(j.id) ? (
              <a href={`/pilares/${mapaPorJob.get(j.id)}`} class="btn fantasma chico">Ver mapa</a>
            ) : resultadoPorJob.has(j.id) ? (
              <a href={`/resultados/${resultadoPorJob.get(j.id)}`} class="btn fantasma chico">Ver presentación</a>
            ) : (
              <a href={`/jobs/${j.id}`} class="btn fantasma chico">Ver progreso</a>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  {operable && (
    <dialog id="dialogo-invitar-usuario" aria-labelledby="invitar-usuario-titulo">
      <h2 id="invitar-usuario-titulo">Invitar usuario de {cliente.nombre}</h2>
      <form id="forma-invitar-usuario">
        <div class="campo" style="margin-top:16px">
          <label for="iu-email">Correo</label>
          <input id="iu-email" name="email" type="email" autocomplete="off" required />
        </div>

        <div id="iu-resultado" hidden style="margin-top:16px">
          <p class="aviso verde" id="iu-mensaje"></p>
          <div class="campo con-icono" style="margin-top:10px">
            <Icono nombre="enlace" />
            <input id="iu-enlace" type="text" readonly aria-label="Enlace de invitación" />
          </div>
          <button type="button" class="btn fantasma chico" id="iu-copiar" style="margin-top:10px"><Icono nombre="copiar" />Copiar</button>
        </div>

        <p class="aviso rosa" id="iu-error" hidden role="alert"></p>

        <div class="acciones">
          <button type="submit" class="btn" id="iu-enviar">Invitar</button>
          <button type="button" class="btn fantasma" id="iu-cerrar">Cerrar</button>
        </div>
      </form>
    </dialog>
  )}

  <dialog id="dialogo-borrar" aria-labelledby="borrar-titulo">
    <h2 id="borrar-titulo">¿Eliminar a {cliente.nombre}?</h2>
    <p class="sub" style="margin:10px 0 0">Se borran también enlaces, archivos e investigaciones. No se puede deshacer.</p>
    <div class="acciones">
      <button type="button" class="btn peligro lleno" id="borrar-de-verdad">Sí, eliminar</button>
      <button type="button" class="btn fantasma" id="cancelar-borrado">Cancelar</button>
    </div>
  </dialog>
</Base>

<script>
  import { toast } from '@/scripts/toast';
  import { copiar } from '@/scripts/copiar';

  const clientId = window.location.pathname.split('/')[2];

  // ── Pestañas: el hash conserva la pestaña al recargar o compartir el enlace.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  function mostrar(nombre: string, enfocar = false) {
    const destino = tabs.find((t) => t.dataset.pestana === nombre) ?? tabs[0];
    for (const t of tabs) {
      const activa = t === destino;
      t.setAttribute('aria-selected', String(activa));
      t.tabIndex = activa ? 0 : -1;
      (document.getElementById(t.getAttribute('aria-controls')!) as HTMLElement).hidden = !activa;
    }
    if (enfocar) destino.focus();
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => { history.replaceState(null, '', `#${t.dataset.pestana}`); mostrar(t.dataset.pestana!); });
    t.addEventListener('keydown', (e) => {
      const paso = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!paso) return;
      const siguiente = tabs[(i + paso + tabs.length) % tabs.length];
      history.replaceState(null, '', `#${siguiente.dataset.pestana}`);
      mostrar(siguiente.dataset.pestana!, true);
    });
  });
  mostrar(location.hash.slice(1) || 'datos');

  // ── Guardar datos. Sin permiso de operar, el botón no se renderiza.
  const forma = document.getElementById('forma') as HTMLFormElement;
  const guardar = document.getElementById('guardar') as HTMLButtonElement | null;
  forma.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!guardar) return;
    guardar.disabled = true;
    try {
      const res = await fetch(`/api/clientes/${clientId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(forma).entries())),
      });
      const cuerpo = await res.json();
      if (cuerpo.ok) toast('Cambios guardados');
      else toast((cuerpo.errores ?? ['No se pudo guardar.']).join(' · '), 'error');
    } catch {
      toast('No se pudo contactar al servidor.', 'error');
    }
    guardar.disabled = false;
  });

  // ── Menú ⋯ y borrado en dos pasos. Sin permiso de operar, «Eliminar» no se renderiza.
  const menuBoton = document.getElementById('menu-boton') as HTMLButtonElement;
  const menuLista = document.getElementById('menu-lista') as HTMLElement;
  const dialogo = document.getElementById('dialogo-borrar') as HTMLDialogElement;
  const cerrarMenu = () => { menuLista.hidden = true; menuBoton.setAttribute('aria-expanded', 'false'); };
  menuBoton.addEventListener('click', (e) => {
    e.stopPropagation();
    const abrir = menuLista.hidden;
    menuLista.hidden = !abrir;
    menuBoton.setAttribute('aria-expanded', String(abrir));
  });
  document.addEventListener('click', cerrarMenu);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarMenu(); });
  document.getElementById('borrar')?.addEventListener('click', () => { cerrarMenu(); dialogo.showModal(); });
  document.getElementById('cancelar-borrado')!.addEventListener('click', () => dialogo.close());
  const borrarDeVerdad = document.getElementById('borrar-de-verdad') as HTMLButtonElement;
  borrarDeVerdad.addEventListener('click', async () => {
    // Se bloquea mientras corre el DELETE para que un doble clic (o un doble
    // tap en móvil) no dispare dos borrados a la vez.
    borrarDeVerdad.disabled = true;
    try {
      const res = await fetch(`/api/clientes/${clientId}`, { method: 'DELETE' });
      if (res.ok) { window.location.href = '/clientes'; return; }
      toast('No se pudo eliminar el cliente.', 'error');
    } catch {
      toast('No se pudo contactar al servidor.', 'error');
    }
    borrarDeVerdad.disabled = false;
  });

  // ── Generar manual. El servidor vuelve a comprobar que haya investigación:
  // la interfaz no es una garantía.
  const growth = document.getElementById('generar-growth') as HTMLButtonElement;
  growth.addEventListener('click', async () => {
    growth.disabled = true;
    const original = growth.textContent;
    growth.textContent = 'Encolando…';
    try {
      const res = await fetch('/api/jobs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientId, tipo: 'growth' }),
      });
      const cuerpo = await res.json();
      if (cuerpo.ok) { location.href = `/jobs/${cuerpo.id}`; return; }
      if (cuerpo.jobId) { location.href = `/jobs/${cuerpo.jobId}`; return; }
      toast((cuerpo.errores ?? ['No se pudo encolar.']).join(' · '), 'error');
    } catch {
      toast('Sin conexión con el servidor.', 'error');
    }
    growth.disabled = false;
    growth.textContent = original;
  });

  // ── Responsable. Solo se renderiza el select para el admin.
  const responsableSelect = document.getElementById('responsable-select') as HTMLSelectElement | null;
  if (responsableSelect) {
    let previo = responsableSelect.value;
    responsableSelect.addEventListener('change', async () => {
      responsableSelect.disabled = true;
      try {
        const res = await fetch(`/api/clientes/${clientId}/operador`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ operadorId: responsableSelect.value }),
        });
        const json = await res.json();
        if (json.ok) {
          toast('Responsable actualizado');
          previo = responsableSelect.value;
        } else {
          toast('No se pudo actualizar el responsable.', 'error');
          responsableSelect.value = previo;
        }
      } catch {
        toast('No se pudo contactar al servidor.', 'error');
        responsableSelect.value = previo;
      }
      responsableSelect.disabled = false;
    });
  }

  // ── Invitar usuario del cliente. El diálogo solo existe si es operable.
  const dialogoInvitarUsuario = document.getElementById('dialogo-invitar-usuario') as HTMLDialogElement | null;
  if (dialogoInvitarUsuario) {
    const formaInvitar = document.getElementById('forma-invitar-usuario') as HTMLFormElement;
    const iuResultado = document.getElementById('iu-resultado') as HTMLElement;
    const iuMensaje = document.getElementById('iu-mensaje') as HTMLElement;
    const iuEnlace = document.getElementById('iu-enlace') as HTMLInputElement;
    const iuError = document.getElementById('iu-error') as HTMLElement;
    const iuEnviar = document.getElementById('iu-enviar') as HTMLButtonElement;

    const MENSAJES_ERROR: Record<string, string> = {
      'correo-invalido': 'El correo no es válido.',
      prohibido: 'No tienes permiso para invitar usuarios de este cliente.',
      'ya-existe': 'Ya existe una cuenta con ese correo.',
    };

    document.getElementById('abrir-invitar-usuario')!.addEventListener('click', () => {
      formaInvitar.reset();
      iuResultado.hidden = true;
      iuError.hidden = true;
      iuEnviar.hidden = false;
      dialogoInvitarUsuario.showModal();
    });
    document.getElementById('iu-cerrar')!.addEventListener('click', () => dialogoInvitarUsuario.close());

    formaInvitar.addEventListener('submit', async (e) => {
      e.preventDefault();
      iuEnviar.disabled = true;
      iuError.hidden = true;
      try {
        const email = (document.getElementById('iu-email') as HTMLInputElement).value;
        const res = await fetch('/api/invitaciones', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, rol: 'cliente', clientId }),
        });
        const json = await res.json();
        if (!res.ok || !json.ok) {
          iuError.textContent = MENSAJES_ERROR[json.error] ?? 'No se pudo crear la invitación.';
          iuError.hidden = false;
          return;
        }
        iuMensaje.textContent = json.correoEnviado ? 'Invitación creada y enviada por correo.' : 'Invitación creada. Copia el enlace y compártelo a mano.';
        iuEnlace.value = json.enlace;
        iuResultado.hidden = false;
        iuEnviar.hidden = true;
      } catch {
        iuError.textContent = 'No se pudo contactar al servidor.';
        iuError.hidden = false;
      } finally {
        iuEnviar.disabled = false;
      }
    });

    document.getElementById('iu-copiar')!.addEventListener('click', () => copiar(iuEnlace.value, iuEnlace));
  }
</script>

