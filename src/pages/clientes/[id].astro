  .ficha-titulo { flex: 1; min-width: 0; }
  .ficha-titulo h1 { overflow-wrap: anywhere; }
  .tarjeta-cabeza-flex { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .subtitulo-invitaciones { margin: 18px 0 0; font-size: 0.9rem; }
</style>
