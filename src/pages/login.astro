---
const error = Astro.url.searchParams.get('error');
const mensaje =
  error === 'bloqueado'
    ? 'Demasiados intentos fallidos. Espera 15 minutos antes de volver a intentar.'
    : error
      ? 'Correo o contraseña incorrectos.'
      : null;
---

<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Entrar · Wozial Studio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="pantalla">
      <form class="tarjeta" method="POST" action="/api/login">
        <p class="marca">Wozial</p>
        <h1>Studio</h1>
        <p class="sub">Investigación de mercado asistida. Acceso restringido.</p>

        {mensaje && <p class="error" role="alert">{mensaje}</p>}

        <label for="email">Correo</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="username"
          required
          autofocus
        />

        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />

        <button type="submit">Entrar</button>
      </form>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --fondo: #08080b;
    --pink: #d4688a;
    --border: rgba(255, 255, 255, 0.12);
    --dim: rgba(255, 255, 255, 0.45);
    --mid: rgba(255, 255, 255, 0.72);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    -webkit-font-smoothing: antialiased;
  }

  body {
    font-family: 'Poppins', -apple-system, sans-serif;
    background: var(--fondo);
    color: #fff;
    line-height: 1.65;
    min-height: 100vh;
    min-height: 100dvh;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.055'/%3E%3C/svg%3E");
    background-size: 256px 256px;
  }

  .pantalla {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 32px 20px;
  }

  .tarjeta {
    width: 100%;
    max-width: 400px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px 34px 34px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }

  .marca {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pink);
  }

  h1 {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 2px;
  }

  .sub {
    font-size: 14px;
    color: var(--dim);
    margin-top: 10px;
    line-height: 1.5;
  }

  .error {
    margin-top: 22px;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 13.5px;
    color: #ffd8e2;
    background: rgba(212, 104, 138, 0.14);
    border: 1px solid rgba(212, 104, 138, 0.42);
  }

  label {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--mid);
    margin-top: 22px;
    margin-bottom: 7px;
  }

  input {
    font-family: inherit;
    font-size: 15px;
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  input:focus {
    outline: none;
    border-color: var(--pink);
    background: rgba(255, 255, 255, 0.08);
  }

  button {
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    background: var(--pink);
    border: none;
    border-radius: 10px;
    padding: 13px;
    margin-top: 30px;
    cursor: pointer;
    transition: filter 0.15s ease;
  }

  button:hover {
    filter: brightness(1.1);
  }

  button:active {
    filter: brightness(0.95);
  }
</style>
