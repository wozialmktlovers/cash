DATABASE_URL=postgres://usuario:clave@localhost:5432/wozial_studio
ANTHROPIC_API_KEY=
SESSION_SECRET=
DATA_DIR=./data
COST_LIMIT_USD=15
COST_ESTIMATE_USD=8
# Tope de gasto (USD) para convertir automáticamente, al arrancar, las
# investigaciones viejas que aún no tienen «lectura para cliente».
COST_LIMIT_CONVERSION_USD=10
# Estimado de costo (USD) que se muestra antes de correr el Mapa de Pilares.
COST_ESTIMATE_PILARES_USD=8
MODEL_RESEARCH=claude-sonnet-5
MODEL_SYNTHESIS=claude-opus-5

# Origen público del Studio, sin diagonal final (p. ej. https://studio.tudominio.mx).
# Se usa en los enlaces que salen del sitio: invitaciones, links públicos /p/ y
# el botón de los correos. Sin ella, los enlaces se derivan de las cabeceras
# x-forwarded-proto / x-forwarded-host (https por omisión en producción) y los
# correos se mandan sin botón.
PUBLIC_BASE_URL=http://localhost:4321

# Apaga la conversión automática de lecturas viejas al arrancar el worker
# (útil en desarrollo, para no gastar saldo en cada reinicio). "0" = apagada.
CONVERTIR_LECTURAS=1

# Correo (Resend). Sin estas dos variables no se manda ningún correo: los avisos
# quedan solo dentro del Studio y la invitación se comparte copiando el enlace.
# Llave de la API de Resend (https://resend.com/api-keys).
RESEND_API_KEY=
# Remitente de los correos; su dominio debe estar verificado en Resend.
# Formato: "Nombre <correo@dominio>", p. ej. Wozial Studio <avisos@tudominio.mx>
CORREO_REMITENTE=
