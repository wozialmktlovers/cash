DATABASE_URL=postgres://usuario:clave@localhost:5432/wozial_studio
ANTHROPIC_API_KEY=
SESSION_SECRET=
DATA_DIR=./data
COST_LIMIT_USD=15
COST_ESTIMATE_USD=8
# Tope de gasto (USD) para convertir automáticamente, al arrancar, las
# investigaciones viejas que aún no tienen «lectura para cliente».
COST_LIMIT_CONVERSION_USD=10
# Estimado de costo (USD) que se muestra antes de correr el Mapa de Pilares.
COST_ESTIMATE_PILARES_USD=8
# Tope de gasto (USD) de UNA petición de propuestas de copy. El contenido
# mensual se genera pieza por pieza, así que este tope es por pieza y no por
# lote: el mes entero nunca se pide de golpe.
COST_LIMIT_PROPUESTAS_USD=0.5
MODEL_RESEARCH=claude-sonnet-5
MODEL_SYNTHESIS=claude-opus-5

# Origen público del Studio, sin diagonal final (p. ej. https://studio.tudominio.mx).
# Se usa en los enlaces que salen del sitio: invitaciones, links públicos /p/ y
# el botón de los correos. Sin ella, los enlaces se derivan de las cabeceras
# x-forwarded-proto / x-forwarded-host (https por omisión en producción) y los
# correos se mandan sin botón.
PUBLIC_BASE_URL=http://localhost:4321

# Apaga la conversión automática de lecturas viejas al arrancar el worker
# (útil en desarrollo, para no gastar saldo en cada reinicio). "0" = apagada.
CONVERTIR_LECTURAS=1

# Correo (SMTP, con un buzón del propio dominio). Sin usuario, contraseña y
# remitente no se manda ningún correo: los avisos quedan solo dentro del Studio
# y la invitación se comparte copiando el enlace a mano.
# Servidor de salida. Por omisión, el de Google Workspace.
CORREO_SMTP_HOST=smtp.gmail.com
# 465 para TLS directo; 587 si el proveedor pide STARTTLS.
CORREO_SMTP_PUERTO=465
# Dirección completa del buzón que manda los correos.
CORREO_SMTP_USUARIO=
# En Google Workspace NO es la contraseña del correo, sino una «contraseña de
# aplicación» de 16 letras, que se genera aparte y exige verificación en dos
# pasos en esa cuenta.
CORREO_SMTP_PASSWORD=
# Remitente que ve quien recibe. Su dirección debe ser la misma de
# CORREO_SMTP_USUARIO, o un alias dado de alta en esa cuenta; si no, Google la
# reescribe. Formato: "Nombre <correo@dominio>".
CORREO_REMITENTE=
